{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "scripts/aria/**/*.ts",
    "scripts/e2e/**/*.ts",
    "lib/aria/**/*.ts",
    "app/api/aria/**/*.ts",
    "components/aria/**/*.ts",
    "components/aria/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".worktrees"
  ]
}
