{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "bilan-report-nexus-draft-v1"
    },
    "audience": {
      "type": "string",
      "const": "NEXUS"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competencyId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "competencyId",
          "title",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competencyId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          }
        },
        "required": [
          "competencyId",
          "title",
          "explanation",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "actionPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recommendationId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cadence": {
            "type": "string"
          },
          "durationWeeks": {
            "type": "integer"
          }
        },
        "required": [
          "recommendationId",
          "title",
          "rationale",
          "actions",
          "cadence",
          "durationWeeks"
        ],
        "additionalProperties": false
      }
    },
    "unmeasuredAreas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competencyId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "competencyId",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "cautionNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closingMessage": {
      "type": "string",
      "const": "Synthèse générée avec assistance IA et revue par l’équipe pédagogique Nexus Réussite."
    },
    "internal": {
      "type": "object",
      "properties": {
        "reviewFocus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reviewFocus"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "audience",
    "title",
    "summary",
    "strengths",
    "priorities",
    "actionPlan",
    "unmeasuredAreas",
    "cautionNotes",
    "closingMessage",
    "internal"
  ],
  "additionalProperties": false
}
