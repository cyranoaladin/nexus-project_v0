{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "bilan-report-parent-v1"
    },
    "audience": {
      "type": "string",
      "const": "PARENT"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competencyId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "competencyId",
          "title",
          "explanation",
          "evidenceRefs"
        ],
        "additionalProperties": false
      }
    },
    "priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competencyId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          }
        },
        "required": [
          "competencyId",
          "title",
          "explanation",
          "evidenceRefs",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "actionPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recommendationId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cadence": {
            "type": "string"
          },
          "durationWeeks": {
            "type": "integer"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "recommendationId",
          "title",
          "rationale",
          "actions",
          "cadence",
          "durationWeeks",
          "evidenceRefs"
        ],
        "additionalProperties": false
      }
    },
    "unmeasuredAreas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competencyId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "competencyId",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "cautionNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closingMessage": {
      "type": "string",
      "const": "Synthèse générée avec assistance IA et revue par l’équipe pédagogique Nexus Réussite."
    },
    "scoreEcho": {
      "type": "object",
      "properties": {
        "points": {
          "type": "integer"
        },
        "maxPoints": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "percentage": {
          "type": "number"
        },
        "calibrationStatus": {
          "type": "string",
          "const": "FINAL"
        }
      },
      "required": [
        "points",
        "maxPoints",
        "percentage",
        "calibrationStatus"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "audience",
    "title",
    "summary",
    "strengths",
    "priorities",
    "actionPlan",
    "unmeasuredAreas",
    "cautionNotes",
    "closingMessage",
    "scoreEcho"
  ],
  "additionalProperties": false
}
