# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# IMPORTANT:
# 1. Copy this file to .env.production
# 2. Fill in ALL values with production secrets
# 3. NEVER commit .env.production to git
# 4. Store secrets in secure vault (e.g., AWS Secrets Manager, 1Password)
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Full URL of your production site (NO trailing slash)
NEXT_PUBLIC_APP_URL=https://nexus.example.com
NEXTAUTH_URL=https://nexus.example.com

# Required distributed rate limiting. Generate a dedicated secret; do not reuse NEXTAUTH_SECRET.
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_TRUST_PROXY_HOPS=1
REDIS_URL=redis://127.0.0.1:6379
EMAIL_OUTBOX_ENCRYPTION_KEY=CHANGE_ME_DEDICATED_EMAIL_OUTBOX_KEY_32_CHARS_MIN
EMAIL_OUTBOX_WORKER_ENABLED=true
EMAIL_OUTBOX_POLL_INTERVAL_MS=5000
EMAIL_OUTBOX_MAX_ATTEMPTS=6
EMAIL_OUTBOX_COMPLETED_RETENTION_DAYS=30
EMAIL_OUTBOX_AMBIGUOUS_ALERT_AGE_MS=900000
EMAIL_OUTBOX_MAINTENANCE_INTERVAL_MS=3600000
EMAIL_MESSAGE_ID_DOMAIN=mail.nexusreussite.academy
ARIA_TURN_RECOVERY_WORKER_ENABLED=true
ARIA_TURN_RECOVERY_POLL_INTERVAL_MS=1000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Docker Compose internal connection (via service name)
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://nexus_user:CHANGE_THIS_PASSWORD@postgres:5432/nexus_reussite_prod?schema=public

# Docker Compose Postgres Config
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=nexus_reussite_prod

# Optional: Performance tuning
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100

# =============================================================================
# DOCUMENT STORAGE - REQUIRED (fail-closed: l'app refuse la requête sans elle)
# =============================================================================
# Chemin ABSOLU d'une racine PERSISTANTE, HORS de tout répertoire de release
# ou de build (elle doit survivre aux bascules) — montée pour l'app ET tout
# worker qui lit/écrit des documents. Même contrat que la CI (jobs build/E2E)
# qui fournit un répertoire éphémère équivalent.
DOCUMENT_STORAGE_ROOT=/srv/example-persistent-storage/documents

# =============================================================================
# NEXTAUTH (Authentication) - REQUIRED
# =============================================================================
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING

# =============================================================================
# SMTP / EMAIL (REQUIRED for user notifications)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@nexus.example.com
SMTP_PASSWORD=CHANGE_THIS_SMTP_PASSWORD
SMTP_FROM=Nexus Réussite <contact@nexus.example.com>
EMAIL_FROM=Nexus Réussite <contact@nexus.example.com>
MAIL_REPLY_TO=contact@nexus.example.com
INTERNAL_NOTIFICATION_EMAIL=contact@nexus.example.com
CRM_LEAD_NOTIFICATION_EMAIL=contact@nexus.example.com

# =============================================================================
# ARIA CONVERSATION MODEL POLICY - OPTIONAL, FAILS CLOSED WHEN UNCONFIGURED
# =============================================================================
# Three provider classes, each with a different transport contract. The model
# string must be an exact identity this provider's allowlist recognises, or
# every ARIA request fails closed with MODEL_TRANSPORT_POLICY_UNKNOWN before
# any network call is attempted -- see lib/aria/infrastructure/model/transport-policy.ts.
#
# OPENAI_HOSTED: direct api.openai.com. No custom base URL (forbidden, not
# merely optional). Example below.
#
# OPENROUTER_HOSTED: OpenRouter's own model catalogue, addressed with its
# `provider/model` routing convention. ARIA_MODEL_BASE_URL must equal the
# canonical OpenRouter endpoint exactly -- an arbitrary remote host is refused.
#   ARIA_MODEL_PROVIDER=OPENROUTER_HOSTED
#   ARIA_MODEL=openai/gpt-5-mini
#   ARIA_MODEL_CAPABILITY_PROFILE=TEXT_STANDARD
#   ARIA_MODEL_BASE_URL=https://openrouter.ai/api/v1
#   ARIA_MODEL_API_KEY=<secret outside Git>
#
# OPENAI_COMPATIBLE_LOCAL: a self-hosted OpenAI-compatible endpoint (Ollama,
# vLLM, ...). Requires an explicit ARIA_MODEL_BASE_URL that is not
# api.openai.com. Any model name is accepted with the legacy request shape --
# there is no fixed catalogue to allowlist a self-hosted endpoint against.
#   ARIA_MODEL_PROVIDER=OPENAI_COMPATIBLE_LOCAL
#   ARIA_MODEL=<your local model name>
#   ARIA_MODEL_CAPABILITY_PROFILE=TEXT_STANDARD
#   ARIA_MODEL_BASE_URL=http://127.0.0.1:11434/v1
#
# Hosted OpenAI example (active below):
ARIA_MODEL_PROVIDER=OPENAI_HOSTED
ARIA_MODEL=gpt-4o-mini
ARIA_MODEL_CAPABILITY_PROFILE=TEXT_STANDARD
ARIA_MODEL_API_KEY=
# Forbidden for OPENAI_HOSTED (always api.openai.com directly) -- required
# for OPENROUTER_HOSTED and OPENAI_COMPATIBLE_LOCAL instead, see above.
ARIA_MODEL_BASE_URL=
ARIA_MODEL_TIMEOUT_MS=30000
ARIA_MODEL_FIRST_TOKEN_TIMEOUT_MS=15000

# A fallback is used only when capability-equivalent and explicitly authorized.
ARIA_MODEL_FALLBACK_PROVIDER=
ARIA_MODEL_FALLBACK_MODEL=
ARIA_MODEL_FALLBACK_CAPABILITY_PROFILE=
ARIA_MODEL_FALLBACK_API_KEY=
# Configure only together with an explicitly authorized fallback provider.
ARIA_MODEL_FALLBACK_BASE_URL=
ARIA_MODEL_FALLBACK_AUTHORIZED=0

# =============================================================================
# EXTERNAL RAG V2 - OPTIONAL, FAILS CLOSED WHEN UNCONFIGURED
# =============================================================================
# No credential belongs in Git. RAG_ENGINE_API_KEY is retrieval-only (rag:search).
# RAG_MANIFEST_API_KEY is ops-only (rag:read-source) for the pre-deploy gate.
# Neither key may reuse the BFF bearer credential or an admin credential.
RAG_API_BASE_URL=
RAG_BFF_SERVICE_TOKEN=change-me
RAG_ENGINE_API_KEY=change-me
RAG_MANIFEST_API_KEY=change-me
ARIA_RAG_ENGINE_TIMEOUT_MS=2500
NEXUS_INTERNAL_TOKEN_SECRET=change-me
NEXUS_INTERNAL_TOKEN_ISSUER=nexus-cockpit
NEXUS_INTERNAL_TOKEN_AUDIENCE=nexus-rag
NEXUS_SSO_ISSUER=nexus-cockpit
NEXUS_SSO_AUDIENCE=nexus-rag

# OTHER AI SERVICES (OPTIONAL)
# Leave empty to disable these non-ARIA integrations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
VECTOR_DIM=3072
EMBEDDING_PROVIDER=openai

# Alternative: Hugging Face
# HUGGINGFACE_HUB_TOKEN=
# HF_EMBEDDING_MODEL=intfloat/e5-large-v2

# =============================================================================
# PAYMENTS - KONNECT (Tunisia) - OPTIONAL
# =============================================================================
# Leave empty to disable payment features
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_BASE_URL=https://api.konnect.network
KONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_KONNECT_PUBLIC_KEY=

# =============================================================================
# PAYMENTS - WISE (International) - OPTIONAL
# =============================================================================
# WISE_API_KEY=
# WISE_PROFILE_ID=

# =============================================================================
# VIDEO CONFERENCING (Jitsi)
# =============================================================================
# Use public Jitsi or self-hosted instance
NEXT_PUBLIC_JITSI_SERVER_URL=https://meet.jit.si
# For self-hosted: https://visio.nexus.example.com

# =============================================================================
# RATE LIMITING
# =============================================================================
# Window in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window per IP
RATE_LIMIT_MAX=60

# =============================================================================
# MICROSERVICES - OPTIONAL (Advanced)
# =============================================================================
# LLM_SERVICE_URL=https://llm.nexus.internal:8003
# PDF_GENERATOR_SERVICE_URL=https://pdf.nexus.internal:8002
# RAG_SERVICE_URL=https://rag.nexus.internal:8001

# =============================================================================
# TELEGRAM (Stage Reservation Notifications)
# =============================================================================
TELEGRAM_NOTIFICATIONS_ENABLED=false
# Required only when TELEGRAM_NOTIFICATIONS_ENABLED=true:
# TELEGRAM_BOT_TOKEN=telegram-token-from-private-secret-store
# TELEGRAM_CHAT_ID=telegram-destination-from-private-secret-store

# =============================================================================
# MONITORING & LOGGING - OPTIONAL
# =============================================================================
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# LOG_LEVEL=info
RATE_LIMIT_KEY_NAMESPACE=production
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=1500
RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS=1500
RATE_LIMIT_REDIS_MAX_RETRIES=2
RATE_LIMIT_TRUST_PROXY_HOPS=1
