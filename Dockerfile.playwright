# =============================================================================
# Dockerfile.playwright — Playwright test runner for E2E
# =============================================================================
# Installs Playwright + browsers, copies test files, runs tests
# =============================================================================

FROM mcr.microsoft.com/playwright:v1.58.2-noble

# poppler-utils (pdftotext) -- lets specs assert on real, rendered PDF text
# content instead of trusting the raw byte buffer (PDF streams are often
# compressed, so a substring check on the raw bytes would silently prove
# nothing either way). T5R3 (family PDF humanization) is the first spec to
# need this; mirrors the same tool already used by the Jest DB-integration
# suite on the host (__tests__/database/t5r-quote-publish.test.ts and
# others), just installed here for the Docker E2E runner too.
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Keep the browser layer supplied by Playwright while enforcing the same
# Node/npm contract as the application and approved production image. The
# upstream archive is pinned and checksum-verified before replacing the base
# image runtime.
ARG NODE_VERSION=22.23.1
ARG NODE_DIST_SHA256=7a8cb04b4a1df4eaf432125324b81b29a088e73570a23259a8de1c65d07fc129
RUN curl --fail --silent --show-error --location \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" \
      --output /tmp/node.tar.gz \
    && echo "${NODE_DIST_SHA256}  /tmp/node.tar.gz" | sha256sum --check --strict \
    && rm -rf /usr/local/include/node /usr/local/lib/node_modules \
      /usr/local/bin/node /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    && tar -xzf /tmp/node.tar.gz --directory /usr/local --strip-components=1 \
    && rm /tmp/node.tar.gz \
    && npm install --global npm@10.9.8 \
    && test "$(node --version)" = "v22.23.1" \
    && test "$(npm --version)" = "10.9.8"

WORKDIR /app

# Copy package files and install deps (for Playwright config resolution)
COPY package.json package-lock.json* ./
RUN npm ci

# Generate Prisma client (needed by e2e/helpers/db.ts)
COPY prisma ./prisma
RUN npx prisma generate

# Copy test files and configs
COPY __tests__/e2e ./__tests__/e2e
COPY __tests__/bilans/fixtures ./__tests__/bilans/fixtures
COPY e2e ./e2e
COPY playwright.config.e2e.ts ./playwright.config.e2e.ts
COPY playwright.config.ts ./playwright.config.ts

# Specs that call application code directly (not just over HTTP) --
# e.g. e2e/auth/bilan-golden-path.spec.ts drains the bilan worker jobs
# in-process -- need the actual lib/ tree, the bank manifests
# (data/bilans/banks/*.json), the prompt files each pack's manifest points
# at (content/bilans/prompts/**), and every asset the PDF renderer inlines
# into the printed report (lib/bilans/render/pdf.ts's ASSETS list:
# public/images/*.png, app/fonts/*.woff2) -- not just the test files
# themselves.
COPY lib ./lib
COPY data ./data
COPY content ./content
COPY public ./public
COPY app/fonts ./app/fonts

# Copy tsconfig for TypeScript resolution
COPY tsconfig.json ./tsconfig.json

# Entrypoint: wait for app, then run tests
COPY scripts/playwright-entrypoint.sh /app/playwright-entrypoint.sh
RUN chmod +x /app/playwright-entrypoint.sh

ENTRYPOINT ["/app/playwright-entrypoint.sh"]
