# =============================================================================
# Dockerfile.playwright — Playwright test runner for E2E
# =============================================================================
# Installs Playwright + browsers, copies test files, runs tests
# =============================================================================

FROM mcr.microsoft.com/playwright:v1.58.2-noble

WORKDIR /app

# Copy package files and install deps (for Playwright config resolution)
COPY package.json package-lock.json* ./
RUN npm ci

# Generate Prisma client (needed by e2e/helpers/db.ts)
COPY prisma ./prisma
RUN npx prisma generate

# Copy test files and configs
COPY __tests__/e2e ./__tests__/e2e
COPY e2e ./e2e
COPY playwright.config.e2e.ts ./playwright.config.e2e.ts
COPY playwright.config.ts ./playwright.config.ts

# Specs that call application code directly (not just over HTTP) --
# e.g. e2e/auth/bilan-golden-path.spec.ts drains the bilan worker jobs
# in-process -- need the actual lib/ tree, the bank manifests
# (data/bilans/banks/*.json), the prompt files each pack's manifest points
# at (content/bilans/prompts/**), and every asset the PDF renderer inlines
# into the printed report (lib/bilans/render/pdf.ts's ASSETS list:
# public/images/*.png, app/fonts/*.woff2) -- not just the test files
# themselves.
COPY lib ./lib
COPY data ./data
COPY content ./content
COPY public ./public
COPY app/fonts ./app/fonts

# e2e/auth/parent-canonical-report-access.spec.ts imports its fact-sheet
# fixture from the Jest tree (__tests__/bilans/fixtures) rather than
# duplicating it under e2e/ — only that one fixture dir is needed here.
COPY __tests__/bilans/fixtures ./__tests__/bilans/fixtures

# Copy tsconfig for TypeScript resolution
COPY tsconfig.json ./tsconfig.json

# Entrypoint: wait for app, then run tests
COPY scripts/playwright-entrypoint.sh /app/playwright-entrypoint.sh
RUN chmod +x /app/playwright-entrypoint.sh

ENTRYPOINT ["/app/playwright-entrypoint.sh"]
