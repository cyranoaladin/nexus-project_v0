  turnId         String?
  turn           AriaConversationTurnCoreV2?      @relation(fields: [turnId, conversationId], references: [id, conversationId], onDelete: Restrict)
  role           AriaConversationMessageRole
  content        String
  metadata       Json?
  turnRole       AriaConversationTurnMessageRole?
  citations      AriaMessageCitationCoreV2[]
  feedbacks      AriaFeedbackCoreV2[]
  createdAt      DateTime                         @default(now())

  @@unique([turnId, turnRole])
  @@index([conversationId, createdAt])
