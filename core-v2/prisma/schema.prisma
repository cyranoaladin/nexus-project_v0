// Core v2 — canonical single-source-of-truth baseline.
//
// Foundation status (feat/core-v2-greenfield-foundation): this schema now has
// its own generated Prisma Client (core-v2/generated/client, see the
// generator block below), its own baseline migration
// (core-v2/prisma/migrations/), and a minimal repository layer
// (lib/core-v2/repositories/) — all provable only against a disposable,
// empty PostgreSQL database (see __tests__/core-v2/golden-empty-db.test.ts).
//
// This is STILL NOT wired into the running application. `npm run build`,
// the live app's `prisma generate`, and every user-facing route continue to
// use only the repository-root `prisma/schema.prisma`/`nexus_prod`. No
// `nexus_core_v2` database exists anywhere except a throwaway one created
// and destroyed by tests/CI. No legacy student is migrated. The one-shot
// extractor (scripts/core-v2/extract-to-core-v2.ts) remains fail-closed —
// see docs/audits/core-v2-canonical-architecture.md for the full status.
//
// Models NOT redesigned here (User identity fields, CoachProfile marketing
// fields, the whole billing cluster) are carried over from prisma/schema.prisma
// essentially unchanged; only their Core v2-relevant relations are shown, to
// keep this file focused on what actually changes. Do not treat omission of
// a field as a decision to drop it — see the audit doc for what's explicitly
// kept vs. deleted. Billing specifically has NO Prisma relation into this
// file at all (not even a dangling FK) — it is genuinely out of scope for
// this redesign, not just visually hidden; see the Billing section at the
// bottom for what that implies and doesn't imply.
//
// The 7 enums under "Enums carried over verbatim" below ARE fully copied
// (not just referenced) — that's a mechanical requirement for this file to
// `prisma validate` standalone, not a design decision; they must stay
// byte-identical to prisma/schema.prisma's definitions at implementation
// time, never diverge here.

datasource db {
  provider = "postgresql"
  url      = env("CORE_V2_DATABASE_URL")
}

// Isolated Prisma Client: a distinct generated output path so this client
// is a structurally different module than the Core v1 client generated
// from ../../prisma/schema.prisma (default node_modules/.prisma/client).
// `import { PrismaClient } from '@prisma/client'` (Core v1) and
// `import { PrismaClient } from '../../core-v2/generated/client'` (Core v2)
// can never resolve to the same module, so there is no accidental type or
// instance confusion between the two clients. Not committed — see .gitignore.
generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// ── Identity / account lifecycle (operational domain) ───────────────────────
//
// `accountStatus` is THE account-state authority. `activatedAt` is a derived
// audit timestamp (when the PENDING_ACTIVATION -> ACTIVE transition happened),
// never read for an authorization or login decision. `sessionVersion` stays
// the session-revocation mechanism: every transition that must invalidate
// live sessions (suspend, disable, password change) increments it.
//
// `email` is stored in canonical normalized form (trim/NFC/lowercase, see
// lib/core-v2/contact.ts) AND protected by a case-insensitive unique index
// (users_email_ci_key, core-v2/prisma/migrations/0006_core_v2_operational_domain)
// so a case-variant duplicate is refused at the DB level even if a writer
// bypasses normalization. `phone` is stored normalized and is deliberately
// NOT unique (several accounts of one household may share a phone).

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  password  String?
  role      UserRole
  firstName String?
  lastName  String?
  phone     String?

  accountStatus AccountStatus @default(PENDING_ACTIVATION)

  activatedAt             DateTime?
  sessionVersion          Int       @default(0)
  registrationCompletedAt DateTime?

  householdParent HouseholdParent?
  student         Student?
  coachProfile    CoachProfile?
  invitations     Invitation[]     @relation("InvitationUser")

  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  studentAcademicYearEnrollments StudentAcademicYearEnrollment[]
  studentCourseEnrollments       StudentCourseEnrollment[]
  coachStudentCourseAssignments  CoachStudentCourseAssignment[]
  planningSeries                 PlanningSeries[]
  issuedInvitations              Invitation[]                    @relation("InvitationIssuer")

  @@map("users")
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DISABLED
}

// ── Invitation (own lifecycle, separate from account state) ─────────────────
//
// State is derived, never stored as a mutable enum:
//   OPEN     = consumedAt IS NULL AND revokedAt IS NULL AND expiresAt > now
//   EXPIRED  = consumedAt IS NULL AND revokedAt IS NULL AND expiresAt <= now
//   CONSUMED = consumedAt IS NOT NULL
//   REVOKED  = revokedAt IS NOT NULL
// Only the token HASH is stored (sha256 of a 32-byte random token) — the raw
// token exists only in the service return value handed to the mail layer.
// At most one non-consumed, non-revoked invitation per user at any time —
// race-safe via partial unique index invitations_open_user_key (migration
// 0006); a resend revokes the prior open invitation in the same transaction.
model Invitation {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("InvitationUser", fields: [userId], references: [id], onDelete: Restrict)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  issuedById String?
  issuedBy   User?     @relation("InvitationIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("invitations")
}

// ── Immutable business audit ────────────────────────────────────────────────
//
// Append-only: a BEFORE UPDATE OR DELETE trigger (migration 0006) raises on
// any row mutation, so no application path — Prisma or raw SQL — can rewrite
// history. No relation to User for the actor on purpose: an audit row must
// survive the actor account's deletion, and must never be cascaded/nulled by
// it. `metadata` is minimal structured context (ids, before/after status),
// never secrets, tokens, password hashes, or free-text PII.
model AuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  subjectType   String
  subjectId     String
  correlationId String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([correlationId])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

enum UserRole {
  ADMIN
  ASSISTANTE
  COACH
  PARENT
  ELEVE
}

// ── Family (Phase 2 / Phase 10) ─────────────────────────────────────────────
//
// Replaces the current "exactly one ParentProfile per Student" shape with a
// real N-parents : N-children relation. ParentStudentLink is NOT replaced —
// it keeps its existing consent/audit purpose and must never be queried as
// a membership authority (enforced by an architecture guard, see
// scripts/core-v2/architecture-guards.ts).

model Household {
  id        String            @id @default(cuid())
  parents   HouseholdParent[]
  students  Student[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("households")
}

// Deletion policy: Cascade is correct here on both edges — this row is pure
// membership (a parent belongs to a household), never academic/financial
// history. Losing it when the household or the user is deleted is expected
// (deletion-policy audit: CASCADE_ALLOWED).
//
// `userId @unique` = one parent user belongs to at most one household.
// At most one primary contact per household — race-safe via partial unique
// index household_parents_primary_contact_key (migration 0006).
model HouseholdParent {
  id               String    @id @default(cuid())
  householdId      String
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPrimaryContact Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@unique([householdId, userId])
  @@map("household_parents")
}

// ── Student (Phase 3 — persistent identity ONLY) ────────────────────────────
//
// Everything year-specific (schoolingStatus, gradeLevel, academicTrack,
// stmgPathway, school, academicRevision) moves to StudentAcademicYearEnrollment
// (below). Student keeps only facts that do not change per school year.
// No `grade` (legacy string), no `specialties` (already removed upstream).

// Deletion policy (deletion-policy audit):
// `household`/`user` are Restrict, not Cascade. A Household/User with an
// existing Student row carries potential academic history one FK away
// (StudentAcademicYearEnrollment, restricted below in turn) — a convenience
// delete of the household or the user account must never silently cascade
// into erasing that history. Explicit, deliberate deletion order is
// required: clear enrollments → delete the Student row → then the
// Household/User can be deleted. HouseholdParent (pure membership, no
// academic content) keeps Cascade — see that model above.
model Student {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  birthDate   DateTime?

  academicYearEnrollments StudentAcademicYearEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("students_v2")
}

// ── Academic year (canonical identity, post-review correction) ─────────────
//
// A prior draft of this file used `schoolYear String` (e.g. "2026-2027") as
// a free-text field on the enrollment row. Reviewed and rejected: free text
// under a `@@unique` constraint is defeated by any typo/format variant
// ("2026-27" vs "2026-2027"), silently producing two rows for one real year.
// `AcademicYear` is the canonical entity instead — ONE unambiguous identity
// per school year, no typographical variants possible. The display label
// ("2026-2027") is DERIVED from `startYear`, never entered as free text
// anywhere in the system.

// `startsAt`/`endsAt` are CONFIGURED per year by the business at creation
// (no hardcoded 1 September / 31 August anywhere in Core v2 — the dates are
// input, validated against startYear, see lib/core-v2/services/academic-year.ts).
// At most one CURRENT year at any time — race-safe via partial unique index
// academic_years_single_current_key (migration 0006). Lifecycle:
// UPCOMING -> CURRENT -> CLOSED, transitions only through the service layer.
model AcademicYear {
  id        String             @id @default(cuid())
  startYear Int                @unique // e.g. 2026 for "2026-2027" — the sole entered identity
  startsAt  DateTime
  endsAt    DateTime
  status    AcademicYearStatus @default(UPCOMING)

  enrollments StudentAcademicYearEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_years")
}

enum AcademicYearStatus {
  UPCOMING
  CURRENT
  CLOSED
}

// Invariant: `endsAt` must be strictly after `startsAt`. Not expressible as
// a Prisma `@@check` in this Prisma version (6.19.3) — enforced by a real SQL
// `CHECK (endsAt > startsAt)` constraint, see
// core-v2/prisma/migrations/0002_core_v2_sql_invariants/migration.sql.

// ── Roster source of truth (Phase 2 / Phase 12-13) ──────────────────────────
//
// THE single authority for "is this student on Nexus's active roster for
// school year X". No implicit status derived from createdAt/recency —
// status is an explicit, closed enum set by an explicit act (owner/
// assistante approval, or a real contractual signal — see
// scripts/core-v2/generate-roster-candidates.ts for how CANDIDATES are
// proposed; approval is always a separate, explicit step, never automatic).

// Deletion policy: `student` is Restrict, not Cascade — a Student with
// enrollment history must not be silently erasable by deleting the Student
// row. Explicit enrollment cleanup is required first (deletion-policy audit).
model StudentAcademicYearEnrollment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  // Creation != approval: a new enrollment is PENDING until an explicit
  // approveEnrollment act (service layer, RBAC ENROLLMENT_APPROVE) moves it
  // to ACTIVE. No direct arbitrary status update — transitions are
  // compare-and-set on the expected previous status.
  status StudentAcademicYearEnrollmentStatus @default(PENDING)

  schoolingStatus SchoolingStatus?
  gradeLevel      GradeLevel
  academicTrack   AcademicTrack    @default(EDS_GENERALE)
  stmgPathway     StmgPathway?
  school          String?

  // Versions THIS year's academic map (level/track/pathway corrections
  // within the year), not a lifetime-of-student counter.
  academicRevision Int @default(0)

  approvedById String?
  approvedBy   User?     @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  courseEnrollments StudentCourseEnrollment[]
  assignments       CoachStudentCourseAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([academicYearId, status])
  @@map("student_academic_year_enrollments")
}

// Closed status set (operational-domain contract §T):
//   PENDING   — created, awaiting explicit approval (default)
//   ACTIVE    — approved; the student is on the roster for that year
//   COMPLETED — year finished normally
//   WITHDRAWN — left during the year, or approval refused
enum StudentAcademicYearEnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  WITHDRAWN
}

// ── Course selection (Phase 4) — StudentAcademicEnrollment carried over,
// re-pointed at the year enrollment instead of the student directly. Shape
// otherwise identical: only explicit SPECIALTY/OPTION choices are stored;
// CORE/TRACK modules stay derived from gradeLevel × academicTrack ×
// stmgPathway via the versioned catalog, never duplicated in DB.

// Deletion policy: `academicYearEnrollment` is Restrict — a chosen course
// enrollment is academic history in its own right and must not vanish as a
// side effect of deleting the parent enrollment row (deletion-policy audit).
model StudentCourseEnrollment {
  id                       String                        @id @default(cuid())
  academicYearEnrollmentId String
  academicYearEnrollment   StudentAcademicYearEnrollment @relation(fields: [academicYearEnrollmentId], references: [id], onDelete: Restrict)

  courseKey String
  kind      AcademicEnrollmentKind // SPECIALTY | OPTION only — see prisma/schema.prisma for the full doc comment on why

  // Foundation hardening §12 (hardcoding audit): this model originally
  // carried `curriculumVersion String @default("v1")`, unused anywhere in
  // Core v2 (no repository read/wrote it, no test exercised it) and with no
  // documented versioning strategy of its own — exactly the "arbitrary
  // default that becomes a hidden authority" this audit was asked to catch.
  // Worse: a REAL curriculum-versioning system already exists in this
  // codebase (lib/curriculum/version-resolution/, documented in
  // docs/bilans/CURRICULUM_VERSIONING.md) — keeping this field risked
  // creating a second, disconnected "curriculum version" authority for the
  // same concept. Dropped here (migration 0005); if/when Core v2 needs
  // curriculum versioning, integrate with the existing system rather than
  // reinventing an unwired string field.

  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearEnrollmentId, courseKey])
  @@map("student_course_enrollments")
}

enum AcademicEnrollmentKind {
  SPECIALTY
  OPTION
}

// ── Coach capability (Phase 5) ──────────────────────────────────────────────
//
// Replaces CoachProfile.subjects (Json) as an authorization source. No new
// Core v2 runtime code may read CoachProfile.subjects for an authorization
// decision — enforced by CORE_V2_MUST_NOT_READ_COACH_SUBJECTS_JSON.

model CoachProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity/marketing fields carried over unchanged (title, pseudonym, tag,
  // description, philosophy, expertise, availableOnline, availableInPerson)
  // — omitted here, not a source-of-truth concern.

  capabilities CoachCourseCapability[]
  assignments  CoachStudentCourseAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coach_profiles_v2")
}

// Deletion policy: Cascade is correct here — a capability grant is
// current-state authorization metadata (what a coach may currently teach),
// not a historical record of what they did teach; that history lives in
// CoachStudentCourseAssignment, which is separately Restrict-protected
// below (deletion-policy audit: CASCADE_ALLOWED).
model CoachCourseCapability {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  courseKey String
  createdAt DateTime     @default(now())

  @@unique([coachId, courseKey])
  @@map("coach_course_capabilities")
}

// ── Assignment (Phase 6) ─────────────────────────────────────────────────────
//
// ONE ROW = ONE COACH + ONE STUDENT/YEAR + ONE COURSEKEY. No subjects[],
// no academicCourseKeys[], no courseScopeState, no BACKFILL_* states — these
// cannot be represented in this shape, which is the point: ambiguity and
// empty scope are impossible BY SCHEMA, not by application discipline.
//
// Invariants enforced at the application layer (NOT expressible as a DB FK,
// stated plainly rather than overclaimed — see docs/audits/core-v2-canonical-architecture.md §CoachStudentCourseAssignment):
//   - courseKey exists in the versioned curriculum catalog
//   - student's academicYearEnrollment actually follows courseKey (explicit
//     StudentCourseEnrollment row, OR courseKey is a legally-derived
//     CORE/TRACK module of that enrollment's gradeLevel×academicTrack)
//   - coach has CoachCourseCapability(courseKey)
//   - no temporally-overlapping duplicate ACTIVE row for the same
//     (coachId, academicYearEnrollmentId, courseKey) triple — enforced via
//     a partial unique index, same pattern as today's
//     entitlements_aria_access_invoice_key (Prisma cannot express a
//     WHERE-clause index, so it is unmanaged here and enforced at the SQL
//     migration level).

// Deletion policy: both `coach` and `academicYearEnrollment` are Restrict —
// an assignment is a business/coaching record in its own right (who taught
// whom, which course, since when). Neither a coach profile nor a student's
// year enrollment may be deleted while assignment history still references
// them; end/reassign the assignment explicitly first (deletion-policy audit).
model CoachStudentCourseAssignment {
  id      String       @id @default(cuid())
  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id], onDelete: Restrict)

  academicYearEnrollmentId String
  academicYearEnrollment   StudentAcademicYearEnrollment @relation(fields: [academicYearEnrollmentId], references: [id], onDelete: Restrict)

  courseKey String
  status    AssignmentStatus @default(ACTIVE)

  // Foundation hardening §13: this model originally carried a speculative
  // `assignmentType AssignmentType?` field ("kept if a real business need
  // survives the audit"), with zero usage anywhere in Core v2 — no
  // repository function read, wrote, or validated it, no test exercised it,
  // and the partial unique index below never included it. Cross-referencing
  // live Core v1 production confirmed the underlying need IS real there:
  // CoachStudentAssignment.assignmentType (PRIMARY/SECONDARY/STAGE/TEMPORARY)
  // is actively used, with its own active-uniqueness index scoped to
  // include it — assistantes do create simultaneous PRIMARY+SECONDARY
  // assignments for the same coach/student/course today. So the business
  // need is confirmed, but not by anything this foundation PR implements or
  // tests — dropped here (migration 0004) rather than carried forward
  // unwired; re-add it, index-scoped and repository-validated, in whichever
  // future PR actually implements primary/secondary coach assignment.
  startsAt DateTime  @default(now())
  endsAt   DateTime?

  assignedById String?
  assignedBy   User?   @relation(fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningSeries  PlanningSeries[]
  sessionBookings SessionBooking[]

  // @@unique([coachId, academicYearEnrollmentId, courseKey]) WHERE status='ACTIVE'
  // — partial index, applied via raw SQL migration, not expressible here.
  @@index([coachId, status])
  @@index([academicYearEnrollmentId, status])
  @@map("coach_student_course_assignments")
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

// ── Planning (Phase 7) ───────────────────────────────────────────────────────
//
// assignmentId becomes the sole authority. studentProfileId/coachProfileId/
// academicCourseKey are DROPPED as stored columns — all three are fully
// derivable via assignment.academicYearEnrollment.student /
// assignment.coach / assignment.courseKey. If a future need for a
// point-in-time snapshot emerges (e.g. displaying historical planning after
// an assignment's courseKey somehow changes — note assignments are otherwise
// immutable on courseKey by design, so this should be rare), that is a
// deliberate re-introduction with its own justification, not a default.

model PlanningSeries {
  id String @id @default(cuid())

  assignmentId String
  assignment   CoachStudentCourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  // No schema default: the organization timezone is configuration
  // (CORE_V2_ORGANIZATION_TIMEZONE, see lib/core-v2/config.ts), resolved by
  // the service layer at creation and stored per series so a later config
  // change never silently re-interprets existing local times.
  timezone       String
  startDate      DateTime @db.Date
  localStartTime String
  localEndTime   String

  recurrenceRule  String
  recurrenceCount Int?
  recurrenceUntil DateTime? @db.Date

  modality SessionModality
  location String?
  status   PlanningSeriesStatus @default(ACTIVE)

  // Optimistic-concurrency counter: incremented on every update, compared
  // in the WHERE clause to reject a write based on a stale read (Review C,
  // final round — the sibling academicRevision field had this documented,
  // this one didn't).
  revision Int @default(0)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  bookings SessionBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignmentId, status])
  @@map("planning_series_v2")
}

// ── Session occurrence (Phase 8) ────────────────────────────────────────────
//
// No legacy User.id identity fields (studentId/coachId/parentId). Identity
// is derived exclusively through assignmentId. Notification targeting
// (today's use of `.parentId`) is resolved at read/notify time via
// assignment.academicYearEnrollment.student.household.parents, not stored
// redundantly on every booking row.

model SessionBooking {
  id String @id @default(cuid())

  assignmentId String
  assignment   CoachStudentCourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  planningSeriesId String?
  planningSeries   PlanningSeries? @relation(fields: [planningSeriesId], references: [id], onDelete: SetNull)
  occurrenceKey    String?         @unique

  overridesBookingId  String?         @unique
  overridesBooking    SessionBooking? @relation("SessionBookingOverrideV2", fields: [overridesBookingId], references: [id], onDelete: SetNull)
  overriddenByBooking SessionBooking? @relation("SessionBookingOverrideV2")

  startsAt DateTime
  endsAt   DateTime
  status   SessionStatus   @default(SCHEDULED)
  modality SessionModality @default(ONLINE)
  location String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  @@index([assignmentId, startsAt])
  @@index([planningSeriesId, startsAt])
  @@index([status, startsAt])
  @@map("session_bookings_v2")
}

// ── Database identity marker (foundation hardening, DATABASE_COLLISION_GUARD_WEAKNESS) ──
//
// Second, independent safety layer alongside the URL target-collision guard
// in lib/core-v2/database-target.ts. URL normalization cannot see
// network/DNS aliasing (two different hostnames resolving to the same
// server); this marker lets the Core v2 client prove, after connecting,
// that it actually landed on a real Core v2 database — not merely one that
// CORE_V2_DATABASE_URL happens to name differently from DATABASE_URL.
//
// Exactly one row (id = 1), created and seeded ONLY by the Core v2 baseline
// migrations (see core-v2/prisma/migrations/0003_core_v2_database_identity).
// The client (lib/core-v2/client.ts) only ever reads this row — it never
// creates or upserts it, so a database that hasn't run the Core v2 baseline
// can never accidentally "pass" the check. Purely a technical schema/
// database identity marker: it duplicates no business truth and carries no
// business meaning of its own.
//
// Deliberately excluded from __tests__/core-v2/helpers/reset-db.ts's
// TRUNCATE list — this row is baseline infrastructure, not per-test business
// state, and must survive every test's reset.
model CoreV2DatabaseIdentity {
  id               Int      @id @default(1)
  schemaIdentity   String
  schemaGeneration Int
  createdAt        DateTime @default(now())

  @@map("core_v2_database_identity")
}

// ── Enums carried over verbatim from prisma/schema.prisma ──────────────────
//
// Copied byte-identical from the live schema at the frozen SHA this design
// was cut from (7313e738928522cb8066c2b323cd745fcd0a48eb) — purely so this
// file `prisma validate`s standalone. NOT a design decision: at
// implementation time these must be re-verified against whatever
// prisma/schema.prisma says then, never assumed still identical.

enum SchoolingStatus {
  SCHOOL_ENROLLED
  INDIVIDUAL
}

enum GradeLevel {
  QUATRIEME
  TROISIEME
  SECONDE
  PREMIERE
  TERMINALE
  POSTBAC
  AUTRE
}

enum AcademicTrack {
  COLLEGE
  EDS_GENERALE
  STMG
  STI2D
  ST2S
  STL
  STD2A
  STMG_NON_LYCEEN
}

enum StmgPathway {
  RHC
  MERCATIQUE
  GF
