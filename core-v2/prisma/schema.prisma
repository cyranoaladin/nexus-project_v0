  subjectStudentId String
  subjectStudent   Student                @relation("AriaConversationTurnSubjectCoreV2", fields: [subjectStudentId], references: [id], onDelete: Restrict)
  actorUserId      String
  actorUser        User                   @relation("AriaConversationTurnActorCoreV2", fields: [actorUserId], references: [id], onDelete: Restrict)
  cancellationRequestedByActorId String?
  cancellationRequestedByActor User? @relation("AriaConversationTurnCancellationActorCoreV2", fields: [cancellationRequestedByActorId], references: [id], onDelete: Restrict)

  useCase                 AriaConversationTurnUseCase
  clientRequestId         String
  requestFingerprint      String
  sequence                Int
  status                  AriaConversationTurnStatus  @default(PENDING)
  executionToken          String?
  heartbeatAt             DateTime?
  leaseExpiresAt          DateTime?
  cancellationRequestedAt DateTime?

  academicSnapshot  Json
  pedagogicalMode   String
  agentRole         String
  visibility        AriaVisibility @default(STUDENT_PRIVATE)
  retrievalPolicy   Json?
  retrievalEvidence Json?
  ragStatus         String?
  policyVersion     String?
  promptVersion     String?
  modelPolicy       Json
  executionMetadata Json?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())

  messages AriaMessageCoreV2[]

  @@unique([actorUserId, subjectStudentId, useCase, clientRequestId])
  @@unique([id, conversationId])
  @@unique([conversationId, sequence])
  @@index([conversationId, status])
  @@index([status, leaseExpiresAt])
  @@index([subjectStudentId, createdAt])
