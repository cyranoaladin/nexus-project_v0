// ── Diagnostics candidats libres (Jalon C — C1) ─────────────────────────────
//
// DiagnosticInstrumentRef is a READ-ONLY mirror of the private instrument
// catalog (nexus-diagnostics-private) at a pinned snapshot. Rows are written
// only by the ingestion script (scripts/core-v2/ingest-diagnostic-catalog.ts),
// never by an API route — the presence of a row, or a filename, is never
// itself an authorization signal (see assertAttributable in
// lib/core-v2/diagnostics/catalog.ts). As of this migration, the private
// catalog's V3 pilot has zero AUTHORIZED instruments (both pilot instruments
// remain at lifecycle status METHOD_PILOT_SAMPLE — see
// nexus-diagnostics-private/V3_PILOT_REVIEW.md, read 2026-09-21) — the only
// seeded row for this increment is DEMO_FIXTURE, entirely fictional and
// invented for this feature's own tests/demo, never derived from real bank
// content.
model DiagnosticInstrumentRef {
  id String @id @default(cuid())

  instrumentKey String
  version       String

  title           String
  subject         String
  level           String
  targetSession   String
  form            String
  durationMinutes Int
  modalities      String

  catalogStatus CatalogStatus @default(UNAVAILABLE)

  // manifestChecksum identifies the CATALOG ENTRY (a checksum of the
  // manifest metadata itself, e.g. "key@version") — it is NOT the
  // checksum of the subject PDF's actual bytes. subjectSha256 is: the
  // real fingerprint of the file served at
  // diagnosticInstrumentSubjectRelativePath(id), verified against at
  // serve time (see getOwnDiagnosticAssignmentForSubjectAccess's caller
  // in the subject route) so a silently-altered or wrong file is refused
  // rather than served (mission §5).
  manifestChecksum String
  manifestVersion  String
  sourceCommit     String?
  subjectSha256    String

  // A private-catalog reference identifying the exact barème/grille this
  // version uses — never the barème content itself (that stays in the
  // private repo). Distinct from manifestChecksum: two instrument
  // versions could share a manifest shape while using different scoring
  // criteria, or vice versa.
  baremeReference String?

  attributionConditions String?

  assignments DiagnosticAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instrumentKey, version])
  @@index([catalogStatus])
  @@map("diagnostic_instrument_refs")
}

enum CatalogStatus {
  AUTHORIZED
  IN_REVIEW
  UNAVAILABLE
  ARCHIVED
  COMPROMISED
  DEMO_FIXTURE
}

// Deletion policy: `instrumentRef` and `student` are Restrict — an
// attribution is a business/pedagogical record in its own right (who was
// assigned what, under which frozen conditions, reviewed by whom). Neither
// a catalog row nor a student may be deleted while attribution history
// still references them.
//
// The *Snapshot fields freeze the instrument's meaning at attribution time
// so a later catalog update never silently changes an attribution already
// handed to a candidate (mission constraint: "une évolution ultérieure du
// catalogue ne doit pas modifier silencieusement une attribution
// commencée").
model DiagnosticAssignment {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  instrumentRefId String
  instrumentRef   DiagnosticInstrumentRef @relation(fields: [instrumentRefId], references: [id], onDelete: Restrict)

  instrumentKeySnapshot     String
  instrumentVersionSnapshot String
  formSnapshot              String
  manifestChecksumSnapshot  String
  subjectSha256Snapshot     String
  baremeReferenceSnapshot   String?
  conditionsSnapshot        String?
  studentProfileSnapshot    Json

  dueAt      DateTime?
  modalities String?

  reviewerId String?
  reviewer   User?   @relation("DiagnosticAssignmentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  status DiagnosticAssignmentStatus @default(ASSIGNED)

  assignedById String?
  assignedBy   User?   @relation("DiagnosticAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  submissions DiagnosticSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Anti-double-click / anti-duplicate-attribution guard: one non-REVOKED
  // attribution per (student, instrument). Partial unique index, applied
  // via raw-SQL migration (same pattern as coach_student_course_assignments):
  // @@unique([studentId, instrumentRefId]) WHERE status != 'REVOKED'
  @@index([studentId, status])
  @@index([instrumentRefId, status])
  @@map("diagnostic_assignments")
}

enum DiagnosticAssignmentStatus {
  ASSIGNED
  SUBMITTED
  REVOKED
}

// Append-only per assignment: a new deposit is a NEW row with an
// incremented `version`, never an update to a prior row's file (mission
// constraint: "un second dépôt ne doit pas écraser silencieusement une
// soumission déjà utilisée pour un bilan"). The "current" submission for an
// assignment is the MAX(version) row among usable statuses (RECEIVED,
// READABLE, ANALYZED); REJECTED rows remain audit history and never supplant
// it. This is computed at query time — never a separate boolean flag, to
// avoid a second source of truth.
model DiagnosticSubmission {
  id String @id @default(cuid())

  assignmentId String
  assignment   DiagnosticAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  version Int

  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String

  status DiagnosticSubmissionStatus @default(RECEIVED)

  submittedById String
  submittedBy   User   @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processing DiagnosticSubmissionProcessing?

  @@unique([assignmentId, version])
  @@index([assignmentId, status])
  @@map("diagnostic_submissions")
}

enum DiagnosticSubmissionStatus {
  RECEIVED
  READABLE
  ANALYZED
  REJECTED
}

// C2, first increment (mission §9): bounded, versioned processing of one
// DiagnosticSubmission — text extraction only for now (no deterministic
// correction, no AI, no publication: those stay unbuilt until the AI
// budget/provider prerequisite is confirmed by the owner — see
// docs/core-v2/candidat-libre-diagnostics-c2-plan.md). One row per
// submission (never recreated — a NEW submission gets its OWN processing
// row, never a reused one). Every frozen field below is copied at enqueue
// time and never re-read from a mutable source afterwards, so a later
// change to the submission or the catalog can never silently retarget an
// already-enqueued processing.
model DiagnosticSubmissionProcessing {
  id String @id @default(cuid())

  submissionId String               @unique
  submission   DiagnosticSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  submissionSha256Snapshot  String
  submissionVersionSnapshot Int
  subjectVersionSnapshot    String

  status DiagnosticSubmissionProcessingStatus @default(QUEUED)

  // Lease-based claim (same pattern as canonical_job_outbox /
  // lib/bilans/worker/drain-outbox.ts, mission §5): EXTRACTING is a
  // LEASED state, not a permanent one. `leaseOwner` identifies which
  // drain cycle currently holds it; `leaseExpiresAt` bounds how long that
  // hold is honoured — a worker that dies mid-extraction (process crash,
  // not just an in-process exception) leaves a lease that simply expires,
  // making the row reclaimable by the next drain cycle without any
  // separate crash-detection mechanism. `attemptCount` is the same
  // quarantine guard as MAX_JOB_ATTEMPTS elsewhere: a deterministically
  // failing submission stops being reclaimed after too many attempts
  // instead of looping forever.
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attemptCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extractions           DiagnosticSubmissionExtraction[]
  aiBudgetLedgerEntries DiagnosticAiBudgetLedger[]
  bilanDrafts           DiagnosticBilanDraft[]

  @@index([status])
  @@map("diagnostic_submission_processings")
}

enum DiagnosticSubmissionProcessingStatus {
  QUEUED
  EXTRACTING
  EXTRACTED
  NO_EXTRACTABLE_TEXT
  EXTRACTION_FAILED
}

// Append-only, one row per attempt (never updated in place): preserves the
// original submission and every extraction attempt as an identifiable,
// ordered revision — a retry after failure creates revision N+1, it never
// overwrites revision N (mission §9: "une nouvelle extraction crée une
// révision identifiable").
model DiagnosticSubmissionExtraction {
  id String @id @default(cuid())

  processingId String
  processing   DiagnosticSubmissionProcessing @relation(fields: [processingId], references: [id], onDelete: Restrict)

  revision Int

  status DiagnosticSubmissionExtractionStatus

  // Populated only for SUCCEEDED; NO_EXTRACTABLE_TEXT and FAILED never
  // fabricate a text value — the absence itself is the recorded state.
  extractedText  String?
  characterCount Int?
  durationMs     Int?
  errorMessage   String?

  // Mission §6: a resource cap must stay visible as a fact, never a
  // silent edit. `characterCount` is the length actually stored above
  // (post-cap); `totalCharacterCount` is the real pre-cap length. A
  // future correction/review step must check `truncated` before ever
  // treating `extractedText` as the whole answer.
  truncated           Boolean @default(false)
  totalCharacterCount Int?

  createdAt DateTime @default(now())

  bilanDrafts DiagnosticBilanDraft[]

  @@unique([processingId, revision])
  @@map("diagnostic_submission_extractions")
}

// Three distinct outcomes, never merged (mission §9): SUCCEEDED (real,
// non-empty extracted text), EMPTY (extraction ran to completion but found
// no exploitable text — e.g. a scanned image PDF; explicitly NOT a success,
// a candidate for different processing such as OCR later), FAILED (the
// extraction itself could not run to completion — corrupt/encrypted/
// unreadable file, or a bounded timeout).
enum DiagnosticSubmissionExtractionStatus {
  SUCCEEDED
  EMPTY
  FAILED
}

// Persistent, reconciliation-safe budget accounting for the C2 AI pilot
// (owner decision, 2026-09-22): never an in-memory counter that resets on
// restart. Every reservation is written BEFORE the provider call it
// covers, so a crash between reservation and the call still counts
// against the budget; a request of unknown outcome (timeout, ambiguous
// network failure) stays RESERVED — never silently dropped — until an
// explicit reconciliation step marks it RELEASED (only when the provider
// definitively confirms no cost was incurred, e.g. rejected at routing
// before any generation).
model DiagnosticAiBudgetLedger {
  id String @id @default(cuid())

  // Fixed constant scoping this exact pilot (AI_PILOT_KEY) — never
  // shared with TeacherBrief or any other AI consumer's own budget.
  pilotKey String

  // Null ONLY for a carry-over/reconciliation entry (mission "TERMINER LA
  // LIVRAISON DE #316", 2026-09-22, §3): a real spend already incurred in
  // a DIFFERENT database (e.g. the disposable dev DB used for the first
  // real pilot call) has no real DiagnosticSubmissionProcessing row to
  // reference in THIS database — and one must never be fabricated just to
  // satisfy this foreign key (mission's own explicit prohibition). A
  // null-processingId row still counts fully toward the pilot-wide cap
  // (readAiBudgetSnapshot's pilot-wide query has no processingId filter);
  // it never counts toward any specific bilan's or audience's own caps.
  processingId String?
  processing   DiagnosticSubmissionProcessing? @relation(fields: [processingId], references: [id], onDelete: Restrict)

  // Which audience-facing generation this reservation covers — null when
  // not yet audience-specific (e.g. a single shared generation reused
  // across audiences). Caps are enforced per (processingId, audienceScope)
  // as well as per processingId alone and pilot-wide.
  audienceScope String?
  attempt       Int     @default(1)

  status DiagnosticAiBudgetEntryStatus @default(RESERVED)

  // The worst-case cost committed to BEFORE the call (input tokens at the
  // request's own bound, output tokens at MAX_OUTPUT_TOKENS) — this is
  // what counts against the cap while status=RESERVED.
  reservedCostUsd Decimal  @db.Decimal(10, 6)
  // The provider-reported real cost, once known. Replaces the reserved
  // estimate for accounting once status=COMMITTED (the real number is
  // always used when present, never inflated by a stale estimate).
  actualCostUsd   Decimal? @db.Decimal(10, 6)

  provider          String?
  model             String?
  endpointTag       String?
  providerRequestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pilotKey, status])
  @@index([processingId, audienceScope])
  @@index([pilotKey, providerRequestId])
  @@map("diagnostic_ai_budget_ledger")
}

enum DiagnosticAiBudgetEntryStatus {
  RESERVED
  COMMITTED
  RELEASED
}

// One row per generation attempt on a given (processingId, extraction
// revision) pair — append-only, same discipline as
// DiagnosticSubmissionExtraction (mission §6: "une réponse tardive d'une
// ancienne tentative ne doit pas écraser le projet courant ou un bilan
// validé"). The "current" draft for a processing is MAX(revision), computed
// at query time, never a separate boolean flag. Once PUBLISHED a draft is
// immutable; a later submission/extraction/generation creates a NEW
// revision, it never mutates a published one.
//
// Four buckets, deliberately never merged into one JSON blob (mission §6):
// deterministicResults (fixed, computed without any AI call),
// aiProposal+aiProvenance (present only when a real provider call
// succeeded — absence stays visible, never backfilled with a guess),
// humanReview (a staff member's corrections/notes, always distinct from
// what the model proposed), and the publish fields (who/when/for which
// audience — never inferred from "a parent account exists").
model DiagnosticBilanDraft {
  id String @id @default(cuid())

  processingId String
  processing   DiagnosticSubmissionProcessing @relation(fields: [processingId], references: [id], onDelete: Restrict)

  revision Int

  extractionId                String
  extraction                  DiagnosticSubmissionExtraction @relation(fields: [extractionId], references: [id], onDelete: Restrict)
  extractionRevisionSnapshot  Int
  extractionTruncatedSnapshot Boolean

  // Computed once, at creation, from deterministic-correction.ts — never
  // re-derived implicitly by a reader; a re-run creates a new revision.
  deterministicResults Json

  // Null until a real, successful AI call completes for this revision.
  // aiProvenance links back to the exact ledger entry, model, endpoint,
  // prompt/schema version and reported cost/tokens — never just "an AI
  // wrote this" with no traceable source.
  aiProposal   Json?
  aiProvenance Json?

  // A staff member's pedagogical corrections layered on top of the
  // deterministic result and the AI proposal — never merged into either.
  // Optimistic-concurrency guard: every write must supply the editVersion
  // it read; a stale write is refused, never silently applied over a
  // concurrent edit.
  humanReview Json?
  editVersion Int   @default(1)

  // Frozen at VALIDATED time from deterministicResults + aiProposal +
  // humanReview.itemCorrections (mission §3) — the ONLY thing the
  // candidate's own read path ever serves. Never the raw humanReview note,
  // never an uncorrected AI item once a human correction replaced it.
  publishedContent Json?

  status DiagnosticBilanDraftStatus @default(DRAFT)

  validatedById String?
  validatedBy   User?     @relation("DiagnosticBilanDraftValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt   DateTime?

  publishedById          String?
  publishedBy            User?     @relation("DiagnosticBilanDraftPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt            DateTime?
  // The real audience matrix decision, never "a parent account exists":
  // which specific self-service audience this revision was published to.
  publishedAudienceScope String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([processingId, revision])
  @@index([processingId, status])
  @@map("diagnostic_bilan_drafts")
}

enum DiagnosticBilanDraftStatus {
  DRAFT
  VALIDATED
  PUBLISHED
}

// ── ARIA, Core v2 native surface (PR "core-v2-aria-foundation") ────────────
//
// V1 identities keep consuming the legacy ARIA persistence (legacy
// database, FK'd to the legacy Student) through /api/aria/**, unchanged.
// CORE_V2 identities are served exclusively by /api/v2/aria/** and the
// models below — never a cross-database FK into the legacy tables, never a
// synthetic legacy Student row created to satisfy one, never a dual write.
// The two surfaces share pure ARIA domain code (catalogue, contracts, skill
// graphs, curriculum resolution) — only the persistence adapter differs.

model AriaCockpitProfileCoreV2 {
  id        String  @id @default(cuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  targetSession     Int?
  pinnedCourseKeys  String[] @default([])
  weeklyGoalMinutes Int      @default(180)

  learningGoals String[] @default([])
  preferences   Json     @default("{}")

  curriculumVersion     String    @default("v1")
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("aria_cockpit_profiles_core_v2")
}

// A product-right authorization, NOT a second billing engine — Subscription
// and Entitlement remain the legacy, V1-Student-keyed authority for
// commercial rights (Phase 11, deliberately out of scope of the Core v2
// redesign). "A Core v2 Student row exists" must never be read as "ARIA is
// authorized" — this model is the explicit, auditable authorization record
// that closes that gap for Core v2 identities. Granted/revoked through a
// normal ADMIN operation (lib/core-v2/aria/access-grants.ts), never
// hardcoded for a specific account.
model AriaAccessGrant {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Mirrors the legacy `AriaFeatureKey` union ('aria_maths' | 'aria_nsi', …)
  // — the same vocabulary, not a second one.
  featureKey   String
  ariaTier     CoreV2AriaTier @default(ARIA_AUTONOMIE)
  // Empty = every course under this featureKey; non-empty narrows the grant
  // to specific course keys (rare, e.g. a pilot limited to one course).
  courseScopes String[]       @default([])

  status   AriaAccessGrantStatus @default(ACTIVE)
  startsAt DateTime              @default(now())
  endsAt   DateTime?

  grantedById String?
  grantedBy   User?   @relation(fields: [grantedById], references: [id], onDelete: SetNull)
  // Free-text operator note (e.g. "pilote qualification 2026-09"), never
  // parsed for authorization — the status/dates/scopes above are the only
  // fields a grant check reads.
  source      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, featureKey, status])
  @@map("aria_access_grants_core_v2")
}

enum AriaAccessGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum CoreV2AriaTier {
  ARIA_AUTONOMIE
  ARIA_SUIVI
  ARIA_ACCOMPAGNEE
}

// ── Native Core v2 conversation foundation (PR C) ─────────────────────────
// These records are keyed only to Core v2 User/Student identities. They are
