model AriaMessageCitationCoreV2 {
  id                String            @id @default(cuid())
  messageId         String
  message           AriaMessageCoreV2 @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sourceTitle       String
  sourceDocument    String
  sourceLocation    String?
  courseKey         String
  provenance        String
  url               String?
  resourceId        String?
  resourceVersionId String?
  contentSha256     String?
  chunkId           String?
  locator           Json?
  corpusId          String?
  corpusVersionId   String?
  manifestSha256    String?

  @@index([messageId])
  @@map("aria_message_citations_core_v2")
}

model AriaFeedbackCoreV2 {
  id        String            @id @default(cuid())
  messageId String
  message   AriaMessageCoreV2 @relation(fields: [messageId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  useful    Boolean
  reason    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([messageId, studentId])
  @@index([studentId, createdAt])
  @@map("aria_feedback_core_v2")
}

enum AriaConversationTurnStatus {
  PENDING
  RUNNING
  COMPLETED
  CANCELLED
  ERROR
}

enum AriaConversationTurnUseCase {
  CONVERSATION
}

enum AriaVisibility {
  STUDENT_PRIVATE
  COACH_VISIBLE
  PARENT_VISIBLE
  SYSTEM_ONLY
}

enum AriaConversationMessageRole {
  USER
  ASSISTANT
}

enum AriaConversationTurnMessageRole {
  USER
  ASSISTANT
}
