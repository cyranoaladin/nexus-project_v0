// ═══════════════════════════════════════════════════════════════════════════════
// Generated Reports (Legacy) - Reports EAF/Premium avec LaTeX
// ═══════════════════════════════════════════════════════════════════════════════

enum GeneratedReportStatus {
  PENDING
  BUILDING_CONTEXT
  LLM_GENERATING
  LLM_VALIDATED
  LATEX_RENDERING
  PDF_READY
  FAILED
  NEEDS_REVIEW
}

model GeneratedPedagogicalReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  coachId String?
  coach   CoachProfile? @relation(fields: [coachId], references: [id], onDelete: SetNull)

  subject         String
  stageSlug       String?
  studentBilanId  String?
  coachReportId   String?
  kind            String
  promptVersion   String
  templateVersion String

  status GeneratedReportStatus @default(PENDING)

  errorCode     String?
  errorMessage  String?
  retryCount    Int     @default(0)
  inputChecksum String?

  contextJson   Json?
  llmJson       Json?
  validatedJson Json?
  modelUsed     String?
  validatedAt   DateTime?

  latexSource String?   @db.Text
  generatedAt DateTime?
  pdfUrl      String?

  @@unique([studentId, stageSlug, subject, kind, inputChecksum], map: "generated_pedagogical_reports_studentId_stageSlug_subject_kin_k")
  @@index([studentId, status])
  @@index([status, createdAt])
  @@map("generated_pedagogical_reports")
