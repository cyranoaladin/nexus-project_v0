  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  domain String // e.g. "analysis", "algebra", "prob_stats", "geometry"
  score  Float // 0-100

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([domain])
  @@map("domain_scores")
