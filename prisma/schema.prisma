// ═══════════════════════════════════════════════════════════════════════════
// Devis candidat individuel (bac général) — moteur de devis partagé
//
// Un seul modèle de devis pour le simulateur public et l'espace assistante
// (lib/quotes/*). Chaque devis fige un snapshot de son contexte de
// tarification au moment de sa création (pricingVersion, examPolicyVersion,
// diagnosticChecksum) : un devis déjà envoyé n'est jamais recalculé
// silencieusement avec de nouveaux tarifs. Les colonnes de révision issues de
// la migration additive initiale restent mappées pour compatibilité de schéma,
// mais aucun workflow de révision n'est exposé par cette release.
//
// Coût enseignant et marge NE sont volontairement PAS des colonnes de ce
// modèle : ils sont calculés à la demande côté serveur à partir de
// QuoteLine + BusinessConfig (namespace "quotes.costPolicy"), jamais
// persistés ici, pour garantir structurellement qu'aucune projection
// publique de Quote/QuoteLine ne peut les exposer.
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// Profil candidat individuel (bac général) — faits bruts, pas de parcours
//
// ProfilCandidat porte uniquement les faits académiques et réglementaires
// déclarés par la famille — jamais un ParcoursType. La classification en
// parcours (P1→P12) reste un point ouvert, non tranché par la direction :
// voir docs/candidat-individuel/reconstruction-parcours-p1-p12.md §10.
// Tant que ce point n'est pas arbitré, seuls les champs qui existent déjà
// ailleurs dans le moteur (lib/quotes/schemas.ts SituationInput, le
// référentiel lib/exams/ du Lot 1) sont repris ici — aucun champ "au cas
// où" pour un parcours pas encore défini.
//
// Séparé de Quote (et non des colonnes dessus) parce qu'il est mutable et
// vit plus longtemps qu'un devis : une même famille peut générer plusieurs
// devis/révisions depuis un même profil (décision D2,
// docs/audit-devis-candidats-libres.md §5).
// ═══════════════════════════════════════════════════════════════════════════

enum CandidateLevel {
  PREMIERE
  TERMINALE
}

/// Modalité de passation des évaluations ponctuelles — voir
/// data/exams/bac-general-2027.json (coefficientParModalite) et le Lot 1.
enum Modalite {
  A
  B
}

/// Les deux seules branches déclaratives codées par le Lot 1
/// (candidatIndividuelRules.basculeScolaireVersIndividuel) pour un candidat
/// qui bascule du statut scolarisé vers le statut individuel en cours de
/// cycle. Non renseigné = jamais scolarisé / pas concerné.
enum BrancheBascule {
  CONSERVATION_MOYENNES_PREMIERE
  RENONCIATION_MOYENNES_PREMIERE
}

/// Classification opérationnelle DÉRIVÉE (jamais saisie directement) —
/// voir docs/candidat-individuel/ADR-PARCOURS-P1-P12.md. 11 valeurs
/// mutuellement exclusives ; P9 (changement de spécialité) n'est PAS ici,
/// c'est un modificateur transverse cumulable (ProfilCandidat.changementSpecialite).
enum ParcoursType {
  P1_LIBRE_2ANS_MODALITE_A
  P2_LIBRE_2ANS_MODALITE_B
  P3_LIBRE_1AN_DEROGATION
  P4_REDOUBLEMENT_PREMIERE
  P5_REDOUBLEMENT_TERMINALE
  P6_AMELIORATION_ET_TERMINALE
  P7_TITULAIRE_BAC
  P8_SCOLARISE_VERS_LIBRE
  P10_EPREUVES_ANTICIPEES_SEULES
  P11_SECOND_GROUPE
  P12_ETALEMENT_PLURISESSIONS
}

model ProfilCandidat {
  id String @id @default(cuid())

  contactLeadId String?
  contactLead   ContactLead? @relation(fields: [contactLeadId], references: [id], onDelete: SetNull)
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  level       CandidateLevel
  examSession Int
  modalite    Modalite

  // Deux spécialités conservées en terminale (colonnes distinctes, pas un
  // tableau, pour garder au niveau DB la garantie "exactement 2" que porte
  // déjà le type SituationInput.specialites: [Subject, Subject]).
  specialite1          Subject
  specialite2          Subject
  specialiteAbandonnee Subject?
  langueA              Subject?
  langueB              Subject?

  estRedoublant             Boolean @default(false)
  estTitulaireBacDejaObtenu Boolean @default(false)

  /// P9 (ADR P1-P12, Q6) — modificateur transverse, cumulable avec
  /// n'importe quel ParcoursType principal, jamais une valeur d'enum.
  changementSpecialite Boolean @default(false)

  /// Distingue P5 (redoublement terminale) de P6 (amélioration + terminale)
  /// quand estRedoublant=true et level=TERMINALE (ADR P1-P12, Q4).
  intentionAmelioration Boolean @default(false)

  /// null = jamais scolarisé / non concerné par une bascule.
  brancheBascule BrancheBascule?

  /// Distingue P10 (épreuves anticipées seules) de P1/P2 (cycle 2 ans
  /// complet) pour un profil level=PREMIERE : le brief mission ne source
  /// aucune règle sur ce point (ni le nombre "12", ni cette distinction, ne
  /// sont retrouvés dans un texte vérifiable — voir reconstruction-
  /// parcours-p1-p12.md). Champ déclaratif volontairement réversible plutôt
  /// que d'inventer une règle réglementaire : true (défaut) = engagement
  /// déclaré sur les deux années, false = anticipées seules cette session,
  /// sans engagement sur la suite.
  intentionCycleComplet Boolean @default(true)

  /// @deprecated superseded by dispensesDeclarees (structured — tracks
  /// DECLAREE/CONFIRMEE/REFUSEE per épreuve, Lot 4 §3). Kept, unused, so an
  /// old row still parses; never read by lib/exams/parcours.ts or carte.ts.
  /// No dual-read/backfill was built: ProfilCandidat itself never existed
  /// on origin/main before this branch (introduced at 2e9e67340, "Lot 2,
  /// scoped") — verified via `git log -S'epreuvesDispenseesDeclarees' --all`
  /// (4 commits, all on this branch) and `git show origin/main:prisma/
  /// schema.prisma | grep -c 'model ProfilCandidat'` (0). No seed, script,
  /// or fixture anywhere in the repo constructs a ProfilCandidat. There is
  /// no legacy data to migrate (Lot 4 correctif, 2026-08-25).
  epreuvesDispenseesDeclarees String[] @default([])

  /// P7 (titulaire du bac) — épreuves que le candidat déclare déjà
  /// validées/dispensées, avec leur statut de validation (codes stables
  /// lib/exams). Périmètre déclaratif tant que statut != CONFIRMEE (arrêté
  /// du 14 mai 2020, cf. Lot 1 dispensesTitulaireBac) : Nexus ne peut pas
  /// vérifier une déclaration seule — genererCarteExamen (Lot 3/4) ne
  /// résout DISPENSEE définitif que pour une entrée CONFIRMEE.
  /// Shape: { epreuveId: string; statut: 'DECLAREE'|'CONFIRMEE'|'REFUSEE' }[]
  dispensesDeclarees Json?

  /// P12 — déclaration d'intention d'étalement sur plusieurs sessions.
  /// Aucun critère de déclenchement n'est sourcé nulle part (mission §3.3
  /// exige seulement que ce cas soit "manuel assisté" et bloque l'émission
  /// automatique) : champ purement déclaratif, jamais dérivé d'une autre
  /// donnée, pour ne pas inventer de règle de détection.
  etalementPlurisessionsDeclare Boolean @default(false)

  /// Renseigné uniquement pour un second groupe (rattrapage) — bornes 8-10
  /// déjà codées Lot 1 (candidatIndividuelRules.secondGroupe).
  moyenneRattrapage Int?

  /// Codes déjà validés par lib/exams/options.ts (validateOptionsSelection).
  optionsTerminale String[] @default([])

  /// {epreuveId, note, sessionObtention}[] — consommé par
  /// resolveConservedNoteCoefficient (lib/exams/catalog.ts). La perte de
  /// mention se déduit de ce tableau non vide (isMentionEligible), ce n'est
  /// délibérément pas une colonne séparée.
  notesConservees Json?

  quotes Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactLeadId])
  @@index([studentId])
  @@map("profils_candidats")
}

enum QuoteStatus {
  ESTIMATION
  BILAN_A_FAIRE
  BILAN_TERMINE
  DEVIS_ENVOYE
  DEVIS_CONSULTE
  A_RAPPELER
  ACCEPTE
  REFUSE
  INSCRIT
  EXPIRE
}

enum QuoteStrategy {
  RESPECT_BUDGET
  BEST_BALANCE
  MOST_COMPLETE
}

enum QuoteSource {
  PUBLIC_SIMULATOR
  STAFF_WORKSPACE
}

/// Lot 5 confinement (docs/candidat-individuel/lot5-catalogue-brainstorming.md
/// Décision 1) — orthogonal to QuoteStatus, never a replacement for it. A
/// quote's commercial status (sent/accepted/...) says nothing about whether
/// its underlying regulatory basis (carte d'examen, dispenses, conservation)
/// was actually verified — this field carries that distinction explicitly so
/// it survives every status transition and every downstream consumer
/// (PDF, public devis page, staff dashboards).
enum QuoteRegulatoryMaturity {
  /// Produced by lib/quotes/exam-profile.ts::buildExamProfile(SituationInput)
  /// — structurally unaware of ParcoursType/EpreuveStatut/dispenses. Every
  /// quote created today is, and remains, this value: nothing in createQuote
  /// currently populates profilId/snapshotCarte. Must always be treated and
  /// disclosed as provisional, regardless of QuoteStatus.
  LEGACY_ESTIMATE_UNVERIFIED
  /// Reserved for the future carte-aware creation path (profilId +
  /// snapshotCarte + snapshotRegles populated from a validateProfilCandidat/
  /// genererCarteExamen pair whose emission gates were both true at creation
  /// time). Not producible by any code today — introduced now so the enum
  /// only needs to grow once.
  CARTE_VALIDATED_DEFINITIVE
}

enum QuoteLineModality {
  PILOTAGE
  GROUPE
  DUO
  INDIVIDUEL
  PACK
}

model Quote {
  id String @id @default(cuid())

  /// SHA-256 hash of the raw public token — never store the raw token
  /// (same pattern as InvoiceAccessToken.tokenHash). A revision is a new
  /// Quote row, so the token rotates automatically on revision.
  publicTokenHash      String   @unique
  publicTokenExpiresAt DateTime

  /// A retried "create quote" request with the same key returns the
  /// existing row instead of creating a duplicate (mission §45).
  idempotencyKey String? @unique

  status QuoteStatus @default(ESTIMATION)
  source QuoteSource

  // Lead / student linkage — reuses ContactLead and Student, no duplicate
  // Candidate/Lead model.
  contactLeadId String?
  contactLead   ContactLead? @relation(fields: [contactLeadId], references: [id], onDelete: SetNull)
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Profil candidat (faits académiques/réglementaires bruts, décision D2) —
  // nullable : un devis peut préexister à tout profil sauvegardé, et un
  // profil peut produire plusieurs devis/révisions (docs/audit-devis-
  // candidats-libres.md §5 D2).
  profilId String?
  profil   ProfilCandidat? @relation(fields: [profilId], references: [id], onDelete: SetNull)

  // Diagnostic linkage — loose coupling via a stable checksum, not a hard FK
  // into the isolated candidate-libre diagnostic feature (CandidateDiagnostic
  // lives in its own bounded context; the quote domain consumes a projection
  // of it, not the model itself).
  diagnosticId       String?
  diagnosticChecksum String?

  // Pricing/regulatory context snapshot — frozen at creation.
  examSession       Int
  pricingVersion    String
  examPolicyVersion String

  /// Classification dérivée (ADR P1-P12) figée au moment de la génération
  /// de la carte d'examen — jamais recalculée après envoi. Reste NULL tant
  /// que resolveParcoursType n'existe pas (Lot 3).
  parcours ParcoursType?

  /// Carte d'examen (épreuve par épreuve, statuts A_PRESENTER/CONSERVEE/
  /// DISPENSEE/RECONDUITE — Lot 3) figée avec cette révision. Reste NULL
  /// tant que genererCarteExamen n'existe pas (Lot 3) ; colonne ajoutée
  /// maintenant pour que la migration Quote reste unique (décision D2).
  snapshotCarte Json?

  /// Sous-ensemble sourcé du référentiel réglementaire (lib/exams/) ayant
  /// servi à produire ce devis, figé avec cette révision — jamais recalculé
  /// après envoi, sur le même principe que pricingVersion/examPolicyVersion.
  snapshotRegles Json?

  /// Lot 5 confinement — see QuoteRegulatoryMaturity. Additive, defaults to
  /// the only value any current code path can produce; never blocks the
  /// existing send/accept mechanics (status transitions are unaffected),
  /// but every consumer (PDF, public page) must disclose it when legacy.
  regulatoryMaturity QuoteRegulatoryMaturity @default(LEGACY_ESTIMATE_UNVERIFIED)

  budget   Int // TND/month, family-declared budget ceiling
  strategy QuoteStrategy

  /// Canonical offer id when this quote resolved to one fixed pack rather
  /// than a sur-mesure combination of modules (mission §21).
  matchedOfferId String?

  currency     String @default("TND")
  monthlyTotal Int // TND — regular monthly installment amount (post-acompte, décision D4)
  grandTotal   Int // TND — total annual price

  /// Acompte (décision D4 — 25% de grandTotal, arrondi). Nullable : les
  /// devis émis avant D4 (modèle 0% d'acompte) n'ont pas cette valeur —
  /// affichée comme un état historique explicite, jamais reconstituée.
  deposit Int?

  /// Dernière mensualité (absorbe l'écart d'arrondi) — égale à monthlyTotal
  /// sauf reliquat. Même règle de nullabilité que deposit.
  lastInstallmentAmount Int?

  validUntil DateTime

  // Reserved revision lineage. Kept in the Prisma mapping because the columns
  // already exist through an additive production migration; no active runtime
  // reads or writes them in this release.
  previousRevisionId String? @unique
  previousRevision   Quote?  @relation("QuoteRevisions", fields: [previousRevisionId], references: [id], onDelete: SetNull)
  supersededBy       Quote?  @relation("QuoteRevisions")
  revisionNumber     Int     @default(1)

  createdByUserId String? // staff user id when source = STAFF_WORKSPACE
  updatedByUserId String?

  lines     QuoteLine[]
  auditLogs QuoteAuditLog[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  consultedAt DateTime?

  @@index([status])
  @@index([contactLeadId])
  @@index([studentId])
  @@index([profilId])
  @@index([createdAt])
  @@map("quotes")
}

/// Immutable snapshot line — never recomputed after creation.
model QuoteLine {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  subject  String // e.g. "Français / EAF", "Mathématiques anticipées" — immutable label snapshot
  modality QuoteLineModality

  hoursPerMonth Int? // null for PILOTAGE/PACK lines
  unitPrice     Int // TND — per-student-per-month for GROUPE/DUO/INDIVIDUEL, flat monthly for PILOTAGE/PACK
  months        Int // months billed (10 for a full Sept→June year, fewer for mid-year entry)
  lineTotal     Int // unitPrice x months

  /// Canonical module/offer id when this line maps 1:1 to a canonical entry.
  offerId String?

  priority String // human-readable priority label from the recommendation engine
  reason   String @db.Text // why this line is/isn't included — shown to the family

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_lines")
}

/// Append-only audit trail — creation and status transitions. Never mutated,
/// only appended.
model QuoteAuditLog {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  action         String // currently "CREATED" or "STATUS_CHANGE"
  actorUserId    String?
  beforeSnapshot Json?
  afterSnapshot  Json?
  note           String?

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_audit_logs")
}

// Assessment Model — Universal evaluation system (multi-subject, multi-grade)
enum AssessmentStatus {
  PENDING
  SCORING
  GENERATING
  COMPLETED
  FAILED
}

model Assessment {
  id            String @id @default(cuid())
  publicShareId String @unique @default(cuid()) // Secure public access token

  // Subject and Grade
  subject String // MATHS, NSI, etc.
  grade   String // PREMIERE, TERMINALE

  // Student Information (studentEmail kept for backward compat + anonymous assessments)
  studentEmail    String
  studentName     String
  studentPhone    String?
  studentMetadata Json? // Additional student data

  // Optional FK to Student (linked post-registration, null for anonymous assessments)
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Assessment Data
  answers     Json // Record<questionId, optionId>
  duration    Int? // Duration in milliseconds
  startedAt   DateTime?
  completedAt DateTime?

  // Scoring Results
  scoringResult   Json? // Full ScoringResult from ScoringFactory (contains all metrics)
  globalScore     Float? // Raw score (0-100) = (totalPoints / maxPoints) * 100 — denormalized for SQL indexing
  confidenceIndex Float? // Student self-awareness index (0-100) — denormalized for SQL indexing

  // Score Standardisé Nexus (SSN) — normalized by cohort (z-score projection 0-100)
  ssn Float? // null until cohort normalization is computed

  // Unified Academic Index (multi-discipline composite, null if single-discipline)
  uai Float?

  // Analysis Results
  analysisJson    Json? // Structured analysis (forces, faiblesses, plan)
  studentMarkdown String? // Rendered bilan for student
  parentsMarkdown String? // Rendered bilan for parents
  nexusMarkdown   String? // Rendered bilan for Nexus team

  // Status and Pipeline
  status   AssessmentStatus @default(PENDING)
  progress Int              @default(0) // 0-100

  // Error Tracking
  errorCode    String?
  errorDetails String?
  retryCount   Int     @default(0)

  // Versioning — track which question bank and scoring engine were used
  assessmentVersion String? // e.g. "maths_terminale_spe_v1", "general_v1"
  engineVersion     String? // e.g. "scorer_v2.1", "generic_v1"

  // Metadata
  userAgent String?
  ipAddress String?

  // Learning Graph v2 relations
  domainScores DomainScore[]
  skillScores  SkillScore[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject, grade])
  @@index([studentEmail])
  @@index([studentId])
  @@index([status])
  @@index([ssn])
  @@index([createdAt])
  @@map("assessments")
}

// ─── Bilan Canonical Model (F49/F51) — Unified report model consolidating Diagnostic, Assessment, StageBilan

enum BilanType {
  DIAGNOSTIC_PRE_STAGE // Legacy Diagnostic (Pallier 2, formulaire compétences)
  ASSESSMENT_QCM // Legacy Assessment (QCM universel multi-matière)
  STAGE_POST // Legacy StageBilan (rapport coach fin de stage)
  CONTINUOUS // Maths 1ère BilanView (progression temps réel)
}

enum BilanStatus {
  PENDING
  SCORING
  GENERATING
  COMPLETED
  FAILED
}

// ─── Canonical bilans persistence ───────────────────────────────────────────
// These models are deliberately independent from legacy Assessment, Diagnostic,
// Bilan and GeneratedPedagogicalReport records. Every historical decision keeps
// the exact versions and checksums used to make it reproducible.

enum ParentStudentLinkState {
  PENDING_PARENT_CONSENT
  VERIFIED
  REVOKED
  EXPIRED
}

/// Origine des réponses d'un attempt canonique. EN_LIGNE : l'élève a répondu
/// depuis sa session. SAISIE_PAPIER : un membre du staff a recopié une copie
/// papier déjà passée. Le scoring est le même ; les faits, non.
enum CanonicalAttemptProvenance {
  EN_LIGNE
  SAISIE_PAPIER
}

enum CanonicalAssessmentAttemptStatus {
  IN_PROGRESS
  DRAFT
  SUBMITTED
  SCORING_FAILED
  SCORED
  REPORT_PENDING_REVIEW
  REPORT_GENERATION_FAILED
  COACH_VALIDATED
  COACH_REJECTED
  PUBLISHED
  INVALIDATED
}

enum EvidenceItemKind {
  ANSWER
  SELF_ASSESSMENT
  OBSERVATION
  SCORE_COMPONENT
}

enum ReportArtifactStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ReportRevisionStatus {
  DRAFT
  PENDING_REVIEW
  CORRECTION_REQUESTED
  COACH_VALIDATED
  APPROVED
  REJECTED
}

enum ReportMaterializationAudience {
  ELEVE
  PARENTS
  NEXUS
}

enum ReportPdfStatus {
  READY
  UNAVAILABLE
}

enum ReportReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum CanonicalOutboxStatus {
  PENDING
  LEASED
  COMPLETED
  FAILED
  CANCELLED
  AMBIGUOUS
  RETRY_SCHEDULED
  FAILED_FINAL
}

enum CanonicalJobType {
  SCORE_ATTEMPT
  GENERATE_REPORT
  PUBLISH_REPORT
  SEND_NOTIFICATION
  SEND_EMAIL
}

enum CanonicalNotificationEventType {
  QUESTIONNAIRE_SUBMITTED
  BILAN_GENERATED
  BILAN_PUBLISHED
  REPORT_GENERATED
  REPORT_REVIEW_REQUESTED
  REPORT_PUBLISHED
}

enum NotificationChannel {
  WHATSAPP
}

model ParentStudentLink {
  id           String                 @id @default(cuid())
  parentUserId String
  parentUser   User                   @relation("CanonicalParentUser", fields: [parentUserId], references: [id], onDelete: Restrict)
  studentId    String
  student      Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  state        ParentStudentLinkState @default(PENDING_PARENT_CONSENT)

  requestedAt   DateTime  @default(now())
  consentedAt   DateTime?
  verifiedAt    DateTime?
  revokedAt     DateTime?
  expiresAt     DateTime?
  revokedReason String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([parentUserId, state])
  @@index([studentId, state])
  @@map("canonical_parent_student_links")
}

model CanonicalAssessmentAttempt {
  id        String                           @id @default(cuid())
  studentId String
  student   Student                          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status    CanonicalAssessmentAttemptStatus @default(DRAFT)

  // Server-generated passation identity and bounded lifetime. `seed` and
  // `expiresAt` deliberately have no database default: creation must provide
  // both values explicitly from the authenticated application flow.
  seed      String
  startedAt DateTime @default(now())
  expiresAt DateTime
  revision  Int      @default(0)

  subject     Subject
  gradeLevel  GradeLevel
  answers     Json
  submittedAt DateTime?

  // Sealed provenance captured with the submitted answers.
  curriculumId           String
  curriculumVersion      String
  assessmentPackId       String
  assessmentPackVersion  String
  assessmentPackChecksum String
  scoringPolicyId        String
  scoringPolicyVersion   String

  // How these answers reached the platform: the student's own online
  // passation, or a staff member transcribing a paper copy. Set by the INSERT
  // that creates the attempt and never updatable — a database trigger rejects
  // any UPDATE touching these three columns, in DRAFT as well as after
  // submission. `enteredById` keeps the audit pseudonymous: an opaque user id,
  // never a name, and it never reaches the rendered report.
  provenance  CanonicalAttemptProvenance @default(EN_LIGNE)
  enteredById String?
  enteredBy   User?                      @relation("CanonicalAttemptPaperEntry", fields: [enteredById], references: [id], onDelete: Restrict)
  enteredAt   DateTime?

  scoreSnapshots  ScoreSnapshot[]
  reportArtifacts ReportArtifact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, studentId])
  @@index([studentId, status, createdAt])
  @@index([assessmentPackId, assessmentPackVersion], map: "canonical_assessment_attempts_assessmentPackId_assessmentPackVe")
  @@index([provenance, createdAt])
  @@map("canonical_assessment_attempts")
}

model CanonicalApiIdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  route          String
  key            String
  response       Json?
  responseStatus Int?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([userId, route, key], map: "canonical_api_idempotency_keys_user_route_key_key")
  @@index([expiresAt])
  @@map("canonical_api_idempotency_keys")
}

model ScoreSnapshot {
  id                  String                     @id @default(cuid())
  assessmentAttemptId String
  assessmentAttempt   CanonicalAssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Restrict)

  scoringPolicyId       String
  scoringPolicyVersion  String
  scoringPolicyChecksum String
  score                 Float
  result                Json
  scoredAt              DateTime @default(now())

  evidenceItems   EvidenceItem[]
  reportRevisions ReportRevision[]

  createdAt     DateTime       @default(now())
  teacherBriefs TeacherBrief[]

  @@unique([assessmentAttemptId])
  @@index([assessmentAttemptId, scoredAt])
  @@map("canonical_score_snapshots")
}

model EvidenceItem {
  id              String           @id @default(cuid())
  scoreSnapshotId String
  scoreSnapshot   ScoreSnapshot    @relation(fields: [scoreSnapshotId], references: [id], onDelete: Restrict)
  kind            EvidenceItemKind
  competencyId    String?
  sourceKey       String
  payload         Json
  createdAt       DateTime         @default(now())

  @@index([scoreSnapshotId, kind])
  @@map("canonical_evidence_items")
}

model ReportArtifact {
  id                  String                     @id @default(cuid())
  studentId           String
  student             Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assessmentAttemptId String
  assessmentAttempt   CanonicalAssessmentAttempt @relation(fields: [assessmentAttemptId, studentId], references: [id, studentId], onDelete: Restrict, map: "canonical_report_artifacts_attempt_student_fkey")
  status              ReportArtifactStatus       @default(DRAFT)

  // This pointer is set only after a reviewed revision is published. SetNull
  // protects the artifact if a deliberately purged revision is ever removed.
  currentPublishedRevisionId String?         @unique
  currentPublishedRevision   ReportRevision? @relation("ReportArtifactCurrentPublishedRevision", fields: [currentPublishedRevisionId, id], references: [id, reportArtifactId], onDelete: Restrict, map: "canonical_report_artifacts_current_revision_same_artifact_fkey")
  publishedAt                DateTime?

  revisions ReportRevision[] @relation("ReportArtifactRevisions")

  shareLinks    ReportShareLink[]
  transmissions ReportTransmission[]
  teacherBriefs TeacherBrief[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentAttemptId])
  @@unique([currentPublishedRevisionId, id])
  @@index([studentId, status, createdAt])
  @@index([assessmentAttemptId])
  @@map("canonical_report_artifacts")
}

model ReportRevision {
  id               String               @id @default(cuid())
  reportArtifactId String
  reportArtifact   ReportArtifact       @relation("ReportArtifactRevisions", fields: [reportArtifactId], references: [id], onDelete: Restrict)
  scoreSnapshotId  String
  scoreSnapshot    ScoreSnapshot        @relation(fields: [scoreSnapshotId], references: [id], onDelete: Restrict)
  status           ReportRevisionStatus @default(DRAFT)

  // Immutable generation provenance.
  reportPackId          String
  reportPackVersion     String
  corpusManifestId      String
  corpusManifestVersion String
  promptRevision        String
  contextChecksum       String
  content               Json
  validationFailures    String[] @default([])

  /// Génération du rendu pour ce snapshot : 1 à la création, incrémentée à
  /// chaque régénération (règle/rendu mis à jour). Le snapshot de score,
  /// lui, ne change jamais.
  generation Int @default(1)

  currentForArtifact ReportArtifact?        @relation("ReportArtifactCurrentPublishedRevision")
  reviews            ReportReview[]
  materialization    ReportMaterialization?
  regenerationsFrom  ReportRegeneration[]   @relation("RegenerationFromRevision")
  regenerationsTo    ReportRegeneration[]   @relation("RegenerationToRevision")

  createdAt DateTime @default(now())

  @@unique([scoreSnapshotId, generation])
  @@unique([id, reportArtifactId])
  @@index([reportArtifactId, createdAt])
  @@index([scoreSnapshotId])
  @@map("canonical_report_revisions")
}

/// Trace append-only d'une régénération de bilan : qui, quand, pourquoi,
/// versions de règle avant/après, brief LLM régénéré ou non, et le diff de
/// profils constaté. L'historique intégral des révisions est conservé —
/// cette table dit pourquoi une nouvelle génération existe.
model ReportRegeneration {
  id                  String         @id @default(cuid())
  fromRevisionId      String
  fromRevision        ReportRevision @relation("RegenerationFromRevision", fields: [fromRevisionId], references: [id], onDelete: Restrict)
  toRevisionId        String
  toRevision          ReportRevision @relation("RegenerationToRevision", fields: [toRevisionId], references: [id], onDelete: Restrict)
  requestedById       String
  requestedBy         User           @relation("ReportRegenerationsRequested", fields: [requestedById], references: [id], onDelete: Restrict)
  motif               String
  engineVersionBefore String
  engineVersionAfter  String
  briefRegenerated    Boolean        @default(false)
  briefPromptVersion  String?
  briefModel          String?
  profileDiff         Json
  wasPublished        Boolean        @default(false)
  createdAt           DateTime       @default(now())

  @@index([toRevisionId])
  @@index([createdAt])
  @@map("canonical_report_regenerations")
}

model ReportMaterialization {
  id             String         @id @default(cuid())
  revisionId     String         @unique
  revision       ReportRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  brandVersion   String
  globalChecksum String
  materializedAt DateTime

  audienceArtifacts ReportAudienceArtifact[]

  @@map("canonical_report_materializations")
}

model ReportAudienceArtifact {
  id                String                        @id @default(cuid())
  materializationId String
  materialization   ReportMaterialization         @relation(fields: [materializationId], references: [id], onDelete: Restrict)
  audience          ReportMaterializationAudience
  html              String                        @db.Text
  pdf               Bytes?
  pdfStatus         ReportPdfStatus
  checksum          String

  @@unique([materializationId, audience], map: "canonical_report_audience_artifacts_materializationId_audience_")
  @@map("canonical_report_audience_artifacts")
}

model ReportReview {
  id               String         @id @default(cuid())
  reportRevisionId String
  reportRevision   ReportRevision @relation(fields: [reportRevisionId], references: [id], onDelete: Restrict)

  // Historical reviewer path (COACH, via CoachProfile). Retired for new
  // rows in favor of reviewerId (ASSISTANTE, via User) — exactly one of
  // the two is set, enforced by a DB CHECK constraint.
  coachId String?
  coach   CoachProfile? @relation(fields: [coachId], references: [id], onDelete: Restrict)

  reviewerId String?
  reviewer   User?   @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  decision   ReportReviewDecision
  motif      String               @db.Text
  reviewedAt DateTime             @default(now())
  createdAt  DateTime             @default(now())

  annotations ReportReviewAnnotation[]

  @@index([reportRevisionId, reviewedAt])
  @@index([coachId, reviewedAt])
  @@index([reviewerId, reviewedAt])
  @@map("canonical_report_reviews")
}

// Annotation de revue : remarque ciblée (audience + section) portée par une
// revue CHANGES_REQUESTED. Métadonnée pure — jamais écrasée (trigger DB).
model ReportReviewAnnotation {
  id             String                        @id @default(cuid())
  reportReviewId String
  reportReview   ReportReview                  @relation(fields: [reportReviewId], references: [id], onDelete: Restrict)
  audience       ReportMaterializationAudience
  section        String
  remark         String                        @db.Text
  createdAt      DateTime                      @default(now())

  @@index([reportReviewId, createdAt])
  @@map("canonical_report_review_annotations")
}

// Lien de consultation signé d'un bilan diffusé. Seule l'empreinte SHA-256
// du secret est stockée ; l'audience NEXUS est interdite par CHECK en base.
model ReportShareLink {
  id               String                        @id @default(cuid())
  reportArtifactId String
  reportArtifact   ReportArtifact                @relation(fields: [reportArtifactId], references: [id], onDelete: Restrict)
  audience         ReportMaterializationAudience
  recipientUserId  String
  recipientUser    User                          @relation("ReportShareLinkRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  tokenHash        String                        @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdById      String
  createdBy        User                          @relation("ReportShareLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime                      @default(now())

  accesses ShareLinkAccess[]

  @@index([reportArtifactId, createdAt])
  @@map("canonical_report_share_links")
}

// Journal de consultation d'un lien signé : date seule, aucune donnée
// identifiante superflue. Append-only (trigger DB).
model ShareLinkAccess {
  id          String          @id @default(cuid())
  shareLinkId String
  shareLink   ReportShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Restrict)
  accessedAt  DateTime        @default(now())

  @@index([shareLinkId, accessedAt])
  @@map("canonical_share_link_accesses")
}

// Confirmation de transmission d'un bilan diffusé au parent, par l'assistante.
// Append-only (trigger DB) : la trace ne se corrige pas, elle s'ajoute.
model ReportTransmission {
  id               String         @id @default(cuid())
  reportArtifactId String
  reportArtifact   ReportArtifact @relation(fields: [reportArtifactId], references: [id], onDelete: Restrict)
  channel          String
  recipientUserId  String
  recipientUser    User           @relation("ReportTransmissionRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  confirmedById    String
  confirmedBy      User           @relation("ReportTransmissionConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt      DateTime       @default(now())

  @@index([reportArtifactId, confirmedAt])
  @@map("canonical_report_transmissions")
}

// Bilan enseignant enrichi (LLM, relecture obligatoire). Document INTERNE :
// jamais transmis aux familles, jamais éligible aux liens signés. Contenu,
// provenance et usage immuables (trigger) ; régénération = nouvelle version.
model TeacherBrief {
  id                 String         @id @default(cuid())
  reportArtifactId   String
  reportArtifact     ReportArtifact @relation(fields: [reportArtifactId], references: [id], onDelete: Restrict)
  scoreSnapshotId    String
  scoreSnapshot      ScoreSnapshot  @relation(fields: [scoreSnapshotId], references: [id], onDelete: Restrict)
  version            Int
  status             String         @default("PENDING_REVIEW")
  content            Json
  editedContent      String?        @db.Text
  promptVersion      String
  model              String
  promptTokens       Int
  cachedPromptTokens Int            @default(0)
  completionTokens   Int
  estimatedCostUsd   Decimal        @db.Decimal(10, 6)
  generationMs       Int
  reviewedById       String?
  reviewedBy         User?          @relation("TeacherBriefReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt         DateTime?
  reviewMotif        String?        @db.Text
  createdById        String
  createdBy          User           @relation("TeacherBriefCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime       @default(now())

  annotations TeacherBriefAnnotation[]

  @@unique([reportArtifactId, version])
  @@index([status, createdAt])
  @@map("canonical_teacher_briefs")
}

model TeacherBriefAnnotation {
  id             String       @id @default(cuid())
  teacherBriefId String
  teacherBrief   TeacherBrief @relation(fields: [teacherBriefId], references: [id], onDelete: Restrict)
  section        String
  remark         String       @db.Text
  authorId       String
  author         User         @relation("TeacherBriefAnnotationAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@index([teacherBriefId, createdAt])
  @@map("canonical_teacher_brief_annotations")
}

model JobOutbox {
  id             String                @id @default(cuid())
  jobType        CanonicalJobType
  aggregateType  String
  aggregateId    String
  sourceEventKey String
  idempotencyKey String                @unique
  status         CanonicalOutboxStatus @default(PENDING)
  payload        Json
  availableAt    DateTime              @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attemptCount   Int                   @default(0)
  completedAt    DateTime?
  lastError      String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([aggregateType, aggregateId])
  @@map("canonical_job_outbox")
}

model NotificationOutbox {
  id              String                         @id @default(cuid())
  eventType       CanonicalNotificationEventType
  sourceEventKey  String
  recipientUserId String
  recipientUser   User                           @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  channel         NotificationChannel
  status          CanonicalOutboxStatus          @default(PENDING)
  payload         Json
  availableAt     DateTime                       @default(now())
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  attemptCount    Int                            @default(0)
  sentAt          DateTime?
  lastError       String?                        @db.Text
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@unique([eventType, sourceEventKey, recipientUserId], map: "canonical_notification_outbox_eventType_sourceEventKey_recipien")
  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([recipientUserId, createdAt])
  @@map("canonical_notification_outbox")
}

model Bilan {
  id            String @id @default(cuid())
  publicShareId String @unique @default(cuid()) // Secure public access token

  // Typologie
  type    BilanType // Canonical type
  subject String // MATHS, NSI, GENERAL, etc.

  // Source identification (for migration traceability)
  // Partial unique indexes created by the canonical migration enforce these
  // identifiers when non-null. Prisma cannot model those partial indexes.
  legacyDiagnosticId String? // FK to legacy Diagnostic (read-only after migration)
  legacyAssessmentId String? // FK to legacy Assessment (read-only after migration)
  legacyStageBilanId String? // FK to legacy StageBilan (read-only after migration)

  // Source data (union of raw inputs from all sources)
  sourceData Json? // Union type: Diagnostic.data | Assessment.answers | StageBilan metadata

  // Student linkage (unified across sources)
  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentEmail String
  studentName  String
  studentPhone String?

  // Relations (optional based on type)
  stageId String?
  stage   Stage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  coachId String?
  coach   CoachProfile? @relation(fields: [coachId], references: [id], onDelete: SetNull)

  // Scores (normalized across all sources)
  globalScore     Float? // 0-100
  confidenceIndex Float? // 0-100 (self-awareness)
  ssn             Float? // Score Standardisé Nexus (z-score 0-100)
  uai             Float? // Unified Academic Index (multi-discipline)
  domainScores    Json? // Array of { domain: string, score: number }

  // Renders (tri-destinataire — common to all bilan types)
  studentMarkdown String? @db.Text // Élève: bienveillant, tutoiement
  parentsMarkdown String? @db.Text // Parents: professionnel, vouvoiement
  nexusMarkdown   String? @db.Text // Nexus: technique, factuel

  // Structured analysis (optional, LLM-generated)
  analysisJson Json? // { forces, faiblesses, plan, ressources, qualityFlags }

  // Publication lifecycle
  status      BilanStatus @default(PENDING)
  progress    Int         @default(0) // 0-100
  isPublished Boolean     @default(false)
  publishedAt DateTime?

  // Error tracking
  errorCode    String? // e.g., "OLLAMA_TIMEOUT", "RAG_UNAVAILABLE"
  errorDetails String? @db.Text
  retryCount   Int     @default(0)

  // Versioning
  sourceVersion  String? // e.g., "diagnostic_v1.3", "assessment_v2.1"
  engineVersion  String? // e.g., "llm_qwen2.5:32b", "manual_coach"
  ragUsed        Boolean  @default(false)
  ragCollections String[] @default([]) // Collections used for RAG context

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([type, status])
  @@index([studentId])
  @@index([studentEmail])
  @@index([stageId])
  @@index([createdAt])
  @@map("bilans")
}

// ─── Learning Graph v2 ──────────────────────────────────────────────────────

// DomainScore — Per-domain score breakdown for an assessment
model DomainScore {
