// ─── Stage Session — a scheduled slot in a stage ─────────────────────────────
model StageSession {
  id          String        @id @default(cuid())
  stageId     String
  stage       Stage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  title       String
  subject     Subject
  startAt     DateTime
  endAt       DateTime
  location    String?
  coachId     String?
  coach       CoachProfile? @relation("CoachStageSessions", fields: [coachId], references: [id], onDelete: SetNull)
  description String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

