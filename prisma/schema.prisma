// ─── Stage Coach — many-to-many coach assignment ─────────────────────────────
model StageCoach {
  id        String       @id @default(cuid())
  stageId   String
  stage     Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  coachId   String
  coach     CoachProfile @relation("CoachStageAssignments", fields: [coachId], references: [id], onDelete: Cascade)
  role      String?
  createdAt DateTime     @default(now())

  @@unique([stageId, coachId])
  @@map("stage_coaches")
}

// ─── Stage Document — pedagogical resource linked to a stage/session ─────────
model StageDocument {
  id             String        @id @default(cuid())
  stageId        String
  stage          Stage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageSessionId String?
  stageSession   StageSession? @relation(fields: [stageSessionId], references: [id], onDelete: SetNull)
  uploadedById   String
  uploadedBy     User          @relation("StageDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  title          String
  description    String?
  fileUrl        String
  fileType       String
  fileSize       Int?
