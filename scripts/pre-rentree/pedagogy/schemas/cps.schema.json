{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusreussite.academy/schemas/pre-rentree-2026/cps.schema.json",
  "title": "Carte de positionnement structurée Pré-rentrée 2026",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "niveauEntree",
    "matiere",
    "edition",
    "dureeCibleMinutes",
    "gamme",
    "intitulePublic",
    "cadrage",
    "statutValidation",
    "noeuds"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "niveauEntree": {
      "enum": ["QUATRIEME", "TROISIEME", "SECONDE", "PREMIERE", "TERMINALE"]
    },
    "matiere": {
      "enum": [
        "MATHEMATIQUES",
        "FRANCAIS",
        "NSI",
        "PHYSIQUE_CHIMIE",
        "SVT",
        "MATHS_EXPERTES",
        "PHILOSOPHIE"
      ]
    },
    "edition": {"const": 2026},
    "dureeCibleMinutes": {"type": "integer", "minimum": 20, "maximum": 25},
    "gamme": {"enum": ["FONDATIONS", "PREMIUM"]},
    "intitulePublic": {"type": "string", "minLength": 1},
    "cadrage": {"type": "string", "minLength": 1},
    "statutValidation": {"const": "HUMAN_VALIDATION_REQUIRED"},
    "noeuds": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordre",
        "evalueParTest",
        "acquisN1",
        "usageN",
        "obstacles",
        "critereMaitrise",
        "seanceRattachement"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^n[0-9]{2}$"},
        "ordre": {"type": "integer", "minimum": 1},
        "evalueParTest": {"type": "boolean"},
        "acquisN1": {"type": "string", "minLength": 1},
        "usageN": {"type": "string", "minLength": 1},
        "obstacles": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "critereMaitrise": {"type": "string", "minLength": 1},
        "seanceRattachement": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 5},
            {"type": "null"}
          ]
        },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/item"}
        },
        "motifNonEvalue": {"type": "string", "minLength": 1},
        "commentairePedagogique": {"type": "string", "minLength": 1},
        "prioriteAbsolue": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"evalueParTest": {"const": true}}},
          "then": {
            "required": ["items"],
            "properties": {
              "seanceRattachement": {"type": "integer", "minimum": 1, "maximum": 5}
            }
          },
          "else": {
            "required": ["motifNonEvalue"],
            "not": {"required": ["items"]}
          }
        }
      ]
    },
    "item": {
      "oneOf": [
        {"$ref": "#/$defs/qcm"},
        {"$ref": "#/$defs/manual"}
      ]
    },
    "qcm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "palier", "type", "enonce", "justification", "propositions"],
      "properties": {
        "id": {"type": "string", "pattern": "^n[0-9]{2}-i[1-3]$"},
        "palier": {"enum": ["A", "B", "C"]},
        "type": {"const": "qcm_unique"},
        "enonce": {"type": "string", "minLength": 1},
        "justification": {"type": "string", "minLength": 1},
        "propositions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/proposition"}
        }
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "palier",
        "type",
        "enonce",
        "justification",
        "correctionManuelle",
        "excluScoringAutomatique",
        "longueurMaxCaracteres",
        "criteresCorrection",
        "exempleReponseAdmissible"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^n[0-9]{2}-i[1-3]$"},
        "palier": {"enum": ["A", "B", "C"]},
        "type": {"const": "reponse_courte"},
        "enonce": {"type": "string", "minLength": 1},
        "justification": {"type": "string", "minLength": 1},
        "correctionManuelle": {"const": true},
        "excluScoringAutomatique": {"const": true},
        "longueurMaxCaracteres": {"type": "integer", "minimum": 1},
        "criteresCorrection": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "exempleReponseAdmissible": {"type": "string", "minLength": 1}
      }
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texte", "correcte"],
      "properties": {
        "texte": {"type": "string", "minLength": 1},
        "correcte": {"type": "boolean"},
        "obstacleVise": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"correcte": {"const": false}}},
          "then": {"required": ["obstacleVise"]},
          "else": {"not": {"required": ["obstacleVise"]}}
        }
      ]
    }
  }
}
