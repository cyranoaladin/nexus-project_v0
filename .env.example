# =============================================================================
# NEXUS RÉUSSITE - Environment Configuration Template
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit .env files with real secrets to version control
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Local development (via Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/nexus_dev?schema=public

# Docker Compose variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus_dev
DATABASE_PASSWORD=postgres

# Production: Use managed PostgreSQL service
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# =============================================================================
# NEXTAUTH (Authentication)
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-minimum-32-characters-change-in-production

# Distributed rate limiting. Memory is allowed only by explicit opt-in in development.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_KEY_SECRET=replace-with-a-dedicated-random-secret-at-least-32-characters
RATE_LIMIT_TRUST_PROXY_HOPS=1
# REDIS_URL=redis://127.0.0.1:6379
EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-a-dedicated-secret-at-least-32-characters
EMAIL_OUTBOX_WORKER_ENABLED=false
EMAIL_OUTBOX_POLL_INTERVAL_MS=5000
EMAIL_OUTBOX_MAX_ATTEMPTS=6
EMAIL_OUTBOX_COMPLETED_RETENTION_DAYS=30
EMAIL_OUTBOX_AMBIGUOUS_ALERT_AGE_MS=900000
EMAIL_OUTBOX_MAINTENANCE_INTERVAL_MS=3600000
EMAIL_MESSAGE_ID_DOMAIN=mail.nexusreussite.academy
ARIA_TURN_RECOVERY_WORKER_ENABLED=false
ARIA_TURN_RECOVERY_POLL_INTERVAL_MS=1000

# Generate with: openssl rand -hex 32

# =============================================================================
# SMTP / EMAIL
# =============================================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@nexusreussite.academy
SMTP_PASS=your-hostinger-smtp-password
# Legacy alias (both are accepted):
SMTP_PASSWORD=your-hostinger-smtp-password
SMTP_FROM=Nexus Réussite <no-reply@nexusreussite.academy>
EMAIL_FROM=Nexus Réussite <no-reply@nexusreussite.academy>
MAIL_FROM=Nexus Réussite <no-reply@nexusreussite.academy>
MAIL_REPLY_TO=support@nexusreussite.academy
INTERNAL_NOTIFICATION_EMAIL=support@nexusreussite.academy
CRM_LEAD_NOTIFICATION_EMAIL=support@nexusreussite.academy
# Set to true to disable all email sending (defaults to true in NODE_ENV=test):
MAIL_DISABLED=false

# =============================================================================
# OPENAI (ARIA AI Assistant)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
VECTOR_DIM=3072

# =============================================================================
# OPENROUTER (Bilans — brief enseignant LLM, narration famille verrouillée)
# =============================================================================
# Clé OpenRouter. Absente en local par défaut (retirée le 2026-08-12, valeur
# de production uniquement côté serveur). Sans elle : brief enseignant non
# généré (repli sans erreur) ; narration famille jamais tentée.
OPENROUTER_API_KEY=
# Modèle utilisé par le brief enseignant (liste blanche BRIEF_POLICY dans
# data/bilans/model-policy.json#/teacherBrief). Défaut si absent : Claude
# Sonnet 4.5.
NEXUS_TEACHER_BRIEF_MODEL=
# Verrou dédié à la narration LLM des bilans familles (worker A88) : avoir
# OPENROUTER_API_KEY seul ne suffit pas à l'activer. Ne PAS passer à "true"
# avant que la revue COACH du FLIP POINT soit re-câblée (cf.
# lib/bilans/worker/generate-report-job.ts).
NEXUS_BILAN_FAMILY_NARRATION_ENABLED=

# =============================================================================
# HUGGING FACE (Alternative AI Models)
# =============================================================================
EMBEDDING_PROVIDER=openai

# =============================================================================
# LLM LOCAL (Ollama + Qwen) — Bilan generation
# =============================================================================
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:32b
OLLAMA_TIMEOUT=180000

# =============================================================================
# LLM_MODE — Controls bilan generation behavior
# =============================================================================
# live  (default) : Real Ollama LLM generation (production)
# stub            : Deterministic short bilans, no network call (staging, fast tests)
# off             : Skip generation entirely, status=COMPLETED + errorCode=LLM_GENERATION_SKIPPED (CI, E2E)
#
# Recommended:
#   Production → live (or unset, defaults to live)
#   CI/E2E     → off
#   Staging    → stub or off
LLM_MODE=live

# =============================================================================
# RAG API — Canonical ChromaDB retrieval via FastAPI ingestor (F19)
# =============================================================================
# ChromaDB ingestor = canonical RAG backend (nomic-embed-text, 768d)
# pgvector disabled for product RAG (F26) — see docs/RAG_ARCHITECTURE.md
RAG_INGESTOR_URL=http://ingestor:8001
# External Nexus RAG API (primary for Maths 1ère)
# Base URL: https://rag-api.nexusreussite.academy
RAG_API_TOKEN=your-rag-api-token-placeholder
RAG_SEARCH_TIMEOUT=10000

# =============================================================================
# MICROSERVICES (Legacy — Optional)
# =============================================================================
# LLM_SERVICE_URL=https://llm.nexus.internal:8003
# RAG_SERVICE_URL=https://rag.nexus.internal:8001

# =============================================================================
# PAYMENTS - KONNECT (Tunisia)
# =============================================================================
# KONNECT_API_KEY=your-konnect-api-key
# KONNECT_WALLET_ID=your-wallet-id
# KONNECT_BASE_URL=https://api.konnect.network
# KONNECT_WEBHOOK_SECRET=your-webhook-secret
# NEXT_PUBLIC_KONNECT_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxx

# =============================================================================
# PAYMENTS - WISE (Manual Display)
# =============================================================================
# WISE_API_KEY=your-wise-api-key
# WISE_PROFILE_ID=your-wise-profile-id

# =============================================================================
# JITSI (Video Conferencing)
# =============================================================================
NEXT_PUBLIC_JITSI_SERVER_URL=https://visio.nexusreussite.academy
# Or use public: https://meet.jit.si

# =============================================================================
# E2E TESTING (Disabled in production)
# =============================================================================
E2E=0

# =============================================================================
# RATE LIMITING
# =============================================================================

# =============================================================================
# LOGGING
# =============================================================================
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# =============================================================================
# DOCUMENT STORAGE (required in production)
# =============================================================================
# Absolute path to persistent document storage directory.
# Must survive release swaps — do NOT place inside a release directory.
# DOCUMENT_STORAGE_ROOT=/var/www/nexus-shared/storage/documents

# =============================================================================
# TELEMETRY
# =============================================================================
NEXT_TELEMETRY_DISABLED=1
# Fenêtre et quota ne se règlent plus variable par variable : les 7 profils
# (auth, api, expensive, ai, public…) sont définis dans lib/rate-limit/presets.
RATE_LIMIT_KEY_NAMESPACE=development
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=1500
RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS=1500
RATE_LIMIT_REDIS_MAX_RETRIES=2
