ARG POSTGRES_IMAGE=postgres:15.19-alpine3.24@sha256:f7d23353e1b15400d22ebe31189f4d314b87a4c129cc400c8c2d8d4ca127bf81
FROM ${POSTGRES_IMAGE} AS builder
USER root
RUN apk upgrade --no-cache && apk add --no-cache build-base git
RUN git init /src && cd /src && git remote add origin https://github.com/pgvector/pgvector.git \
 && git fetch --depth=1 origin f37c13f68b57d2c3472b2214fbcff699d6d34876 \
 && git checkout --detach FETCH_HEAD && test "$(git rev-parse HEAD)" = f37c13f68b57d2c3472b2214fbcff699d6d34876 \
 && make PG_CONFIG=/usr/local/bin/pg_config OPTFLAGS="" with_llvm=no \
 && make PG_CONFIG=/usr/local/bin/pg_config OPTFLAGS="" with_llvm=no install
FROM ${POSTGRES_IMAGE}
USER root
RUN apk upgrade --no-cache \
 && apk add --no-cache libssl3=3.5.9-r0 libcrypto3=3.5.9-r0 zlib=1.3.2-r1 \
 && rm -f /usr/local/bin/gosu /usr/local/bin/su-exec \
 && test "$(id -u postgres)" = 70
COPY --from=builder /usr/local/lib/postgresql/vector.so /usr/local/lib/postgresql/vector.so
COPY --from=builder /usr/local/share/postgresql/extension/vector* /usr/local/share/postgresql/extension/
RUN postgres --version && test -f /usr/local/share/postgresql/extension/btree_gist.control
USER 70:70
