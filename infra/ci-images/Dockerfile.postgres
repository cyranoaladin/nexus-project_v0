# PostgreSQL CI and new Core databases; never a physical V1 PGDATA migration.
ARG POSTGRES_IMAGE=postgres:16.15-alpine3.24@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
FROM ${POSTGRES_IMAGE}
USER root
RUN apk upgrade --no-cache \
 && apk add --no-cache libssl3=3.5.9-r0 libcrypto3=3.5.9-r0 zlib=1.3.2-r1 \
 && rm -f /usr/local/bin/gosu /usr/local/bin/su-exec \
 && test "$(id -u postgres)" = 70 \
 && postgres --version && test -f /usr/local/share/postgresql/extension/btree_gist.control
USER 70:70
