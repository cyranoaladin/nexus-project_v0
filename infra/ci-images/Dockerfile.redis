FROM redis:7.4.11-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499
USER root
RUN apk upgrade --no-cache \
 && apk add --no-cache libssl3=3.3.7-r2 libcrypto3=3.3.7-r2 zlib=1.3.2-r1 \
 && rm -f /usr/local/bin/gosu /usr/local/bin/su-exec \
 && redis-server --version
USER 999:1000
